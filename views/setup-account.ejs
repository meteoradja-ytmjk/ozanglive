<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
  <title>Account Setup - <%= typeof branding !== 'undefined' && branding.app_name ? branding.app_name : 'MonsterLive' %></title>
  <link rel="icon" href="<%= typeof branding !== 'undefined' && branding.favicon_path ? branding.favicon_path : '/images/logo_mobile.svg' %>" type="image/png">
  <link rel="preload" href="<%= typeof branding !== 'undefined' && branding.logo_path ? branding.logo_path : '/images/logo_mobile.svg' %>" as="image">
  <link rel="alternate icon" href="<%= typeof branding !== 'undefined' && branding.favicon_path ? branding.favicon_path : '/images/favicon.ico' %>" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.30.0/tabler-icons.min.css">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      background-color: #070611;
      overflow-x: hidden;
      min-height: 100vh;
    }
    input { font-size: 15px !important; }
    
    /* Neon Glow Effects */
    .neon-card {
      background: rgba(14, 12, 28, 0.92);
      border: 1px solid rgba(139, 92, 246, 0.28);
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.9), 0 0 40px -10px rgba(124, 58, 237, 0.22);
      backdrop-filter: blur(20px);
    }
    .neon-input-wrap {
      border: 1.8px solid rgba(139, 92, 246, 0.75);
      background: rgba(9, 7, 22, 0.85);
      box-shadow: 0 0 16px rgba(139, 92, 246, 0.12);
      transition: all 0.25s ease;
    }
    .neon-input-wrap:focus-within {
      border-color: #a855f7;
      box-shadow: 0 0 22px rgba(168, 85, 247, 0.45), inset 0 0 10px rgba(168, 85, 247, 0.15);
      transform: translateY(-1px);
    }
    .neon-btn {
      background: linear-gradient(135deg, #a855f7 0%, #8b5cf6 45%, #7c3aed 75%, #6366f1 100%);
      box-shadow: 0 4px 25px 0px rgba(168, 85, 247, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.25);
      transition: all 0.25s ease;
    }
    .neon-btn:hover {
      filter: brightness(1.12);
      box-shadow: 0 6px 32px 2px rgba(168, 85, 247, 0.8), inset 0 1px 2px rgba(255, 255, 255, 0.4);
      transform: translateY(-1px);
    }
    .neon-btn:active {
      transform: scale(0.99);
    }
  </style>
</head>
<body class="text-white min-h-screen relative flex items-center justify-center p-4 sm:p-6 select-none selection:bg-purple-500 selection:text-white">

  <!-- Ambient Background Glows -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-purple-600/15 rounded-full blur-[120px]"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-indigo-600/15 rounded-full blur-[120px]"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-purple-900/10 rounded-full blur-[140px]"></div>

    <!-- Neon Wave Graphics -->
    <!-- Left Bottom Waves -->
    <svg class="absolute bottom-0 left-0 w-80 sm:w-[420px] opacity-40 sm:opacity-50 pointer-events-none" viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="neonGrad1" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#a855f7" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#6366f1" stop-opacity="0.1" />
        </linearGradient>
      </defs>
      <path d="M-50 480 C 80 440, 160 380, 220 300 C 270 230, 290 140, 290 40" stroke="url(#neonGrad1)" stroke-width="1.8" />
      <path d="M-50 510 C 100 460, 180 390, 250 290 C 310 200, 330 90, 330 -10" stroke="url(#neonGrad1)" stroke-width="1.6" opacity="0.8" />
      <path d="M-50 540 C 120 480, 210 400, 280 280 C 340 180, 360 50, 360 -40" stroke="url(#neonGrad1)" stroke-width="1.4" opacity="0.6" />
      <path d="M-50 570 C 140 500, 230 410, 310 270 C 370 150, 390 10, 390 -70" stroke="url(#neonGrad1)" stroke-width="1.2" opacity="0.4" />
      <path d="M-50 600 C 160 520, 250 420, 340 260 C 400 130, 420 -30, 420 -100" stroke="url(#neonGrad1)" stroke-width="1" opacity="0.3" />
    </svg>

    <!-- Right Edge Waves -->
    <svg class="absolute top-1/4 right-0 w-72 sm:w-[380px] opacity-40 sm:opacity-50 pointer-events-none translate-x-12" viewBox="0 0 500 700" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="neonGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#c084fc" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#7c3aed" stop-opacity="0.1" />
        </linearGradient>
      </defs>
      <path d="M450 0 C 350 140, 290 280, 280 440 C 275 520, 290 620, 350 700" stroke="url(#neonGrad2)" stroke-width="1.8" />
      <path d="M480 20 C 380 160, 320 300, 310 460 C 305 540, 320 640, 380 720" stroke="url(#neonGrad2)" stroke-width="1.6" opacity="0.8" />
      <path d="M510 40 C 410 180, 350 320, 340 480 C 335 560, 350 660, 410 740" stroke="url(#neonGrad2)" stroke-width="1.4" opacity="0.6" />
      <path d="M540 60 C 440 200, 380 340, 370 500 C 365 580, 380 680, 440 760" stroke="url(#neonGrad2)" stroke-width="1.2" opacity="0.4" />
    </svg>
  </div>

  <!-- Account Setup Card Container -->
  <div class="w-full max-w-[480px] z-10 py-6">
    <div class="neon-card rounded-[28px] p-6 sm:p-9 relative">

      <!-- Branding / Logo & Header -->
      <div class="flex flex-col items-center justify-center mb-6">
        <img src="<%= typeof branding !== 'undefined' && branding.logo_path ? branding.logo_path : '/images/logo_mobile.svg' %>" 
             alt="<%= typeof branding !== 'undefined' && branding.app_name ? branding.app_name : 'MonsterLive' %> Logo" 
             class="h-14 max-w-[200px] object-contain drop-shadow-[0_0_20px_rgba(168,85,247,0.35)] hover:scale-105 transition-transform duration-300">
        <h1 class="text-xl sm:text-2xl font-bold mt-3 text-white tracking-tight">Complete Your Account</h1>
        <p class="text-gray-400 text-xs sm:text-sm mt-1">Set up your profile to get started</p>
      </div>

      <!-- Flash Error Message -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-950/40 border border-red-500/40 text-red-300 px-4 py-3 rounded-2xl mb-6 shadow-[0_0_15px_rgba(239,68,68,0.15)] flex items-center gap-2 text-sm">
          <i class="ti ti-alert-circle text-lg text-red-400 shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form id="setupForm" action="/setup-account" method="post" enctype="multipart/form-data" class="space-y-4">
        <input type="hidden" name="user_role" value="admin">
        <input type="hidden" name="status" value="active">
        
        <!-- Avatar Upload -->
        <div class="flex flex-col items-center justify-center pb-2">
          <div class="relative group cursor-pointer">
            <div id="avatar-preview"
              class="w-24 h-24 rounded-full bg-[#090716] border-2 border-purple-500/70 group-hover:border-purple-400 flex items-center justify-center text-purple-400 overflow-hidden shadow-[0_0_20px_rgba(147,51,234,0.25)] group-hover:shadow-[0_0_25px_rgba(168,85,247,0.45)] transition-all duration-300">
              <i class="ti ti-user text-3xl"></i>
            </div>
            <label for="avatar-upload"
              class="absolute bottom-0 right-0 flex items-center justify-center w-8 h-8 rounded-full bg-gradient-to-r from-purple-500 to-indigo-500 cursor-pointer shadow-lg hover:brightness-110 active:scale-95 transition-all border border-white/20">
              <i class="ti ti-camera text-white text-sm"></i>
            </label>
            <input id="avatar-upload" name="avatar" type="file" accept="image/*" class="hidden"
              onchange="previewAvatar(event)">
          </div>
          <p class="text-xs text-gray-400 mt-2">Upload profile picture (optional)</p>
        </div>

        <!-- Username Input -->
        <div class="relative">
          <div class="neon-input-wrap rounded-2xl flex items-center px-4 py-3.5">
            <i class="ti ti-user text-purple-400 text-xl mr-3 shrink-0"></i>
            <input type="text" id="username" name="username"
              class="w-full bg-transparent text-white placeholder-gray-500 outline-none text-sm sm:text-base selection:bg-purple-500"
              placeholder="Choose an admin username" autocomplete="username" required>
          </div>
          <p id="username-error" class="hidden text-red-400 text-xs mt-1 ml-2"></p>
        </div>

        <!-- Password Input -->
        <div class="relative">
          <div class="neon-input-wrap rounded-2xl flex items-center px-4 py-3.5">
            <i class="ti ti-lock text-purple-400 text-xl mr-3 shrink-0"></i>
            <input type="password" id="password" name="password"
              class="w-full bg-transparent text-white placeholder-gray-500 outline-none text-sm sm:text-base selection:bg-purple-500 pr-2"
              placeholder="Create a strong password" autocomplete="new-password" required minlength="6">
            <button type="button" onclick="togglePasswordVisibility('password', 'passwordToggle')" aria-label="Toggle password visibility"
              class="text-purple-400/70 hover:text-purple-300 active:scale-95 transition-all p-1 cursor-pointer">
              <i class="ti ti-eye text-xl" id="passwordToggle"></i>
            </button>
          </div>
          
          <!-- Password Strength Indicator -->
          <div class="mt-2 px-1">
            <div class="w-full bg-white/10 rounded-full h-1.5 overflow-hidden">
              <div id="password-strength" class="bg-purple-500 h-1.5 rounded-full transition-all duration-300 shadow-[0_0_8px_rgba(168,85,247,0.6)]" style="width: 0%"></div>
            </div>
            <p id="password-feedback" class="text-xs text-gray-400 mt-1">Use 8+ characters with letters, numbers & symbols</p>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-2">
          <button type="submit"
            class="neon-btn w-full text-white py-3.5 px-6 rounded-2xl font-bold text-base tracking-wide flex items-center justify-center gap-2 cursor-pointer">
            <span>Complete Setup</span>
          </button>
        </div>
      </form>

    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const icons = document.querySelectorAll('.ti');
      icons.forEach(icon => {
        icon.classList.add('font-loaded');
      });
    });

    function previewAvatar(event) {
      const input = event.target;
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function (e) {
          const preview = document.getElementById('avatar-preview');
          preview.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover">`;
        }
        reader.readAsDataURL(input.files[0]);
      }
    }

    function togglePasswordVisibility(inputId, toggleId) {
      const input = document.getElementById(inputId);
      const toggle = document.getElementById(toggleId);
      if (input.type === 'password') {
        input.type = 'text';
        toggle.classList.remove('ti-eye');
        toggle.classList.add('ti-eye-off');
      } else {
        input.type = 'password';
        toggle.classList.remove('ti-eye-off');
        toggle.classList.add('ti-eye');
      }
    }

    document.getElementById('password').addEventListener('input', function (e) {
      const password = e.target.value;
      const strength = calculatePasswordStrength(password);
      const strengthBar = document.getElementById('password-strength');
      const feedback = document.getElementById('password-feedback');
      strengthBar.style.width = strength.score * 25 + '%';
      
      if (strength.score === 0) {
        strengthBar.className = 'bg-white/10 h-1.5 rounded-full';
        feedback.textContent = 'Use 8+ characters with letters, numbers & symbols';
        feedback.className = 'text-xs text-gray-400 mt-1';
      } else if (strength.score === 1) {
        strengthBar.className = 'bg-red-500 h-1.5 rounded-full shadow-[0_0_8px_rgba(239,68,68,0.6)]';
        feedback.textContent = 'Too weak - password needs improvement';
        feedback.className = 'text-xs text-red-400 mt-1';
      } else if (strength.score === 2) {
        strengthBar.className = 'bg-amber-400 h-1.5 rounded-full shadow-[0_0_8px_rgba(251,191,36,0.6)]';
        feedback.textContent = 'Could be stronger - add more variety';
        feedback.className = 'text-xs text-amber-400 mt-1';
      } else if (strength.score === 3) {
        strengthBar.className = 'bg-purple-400 h-1.5 rounded-full shadow-[0_0_8px_rgba(192,132,252,0.6)]';
        feedback.textContent = 'Good password';
        feedback.className = 'text-xs text-purple-300 mt-1';
      } else {
        strengthBar.className = 'bg-emerald-400 h-1.5 rounded-full shadow-[0_0_8px_rgba(52,211,153,0.6)]';
        feedback.textContent = 'Strong password - excellent!';
        feedback.className = 'text-xs text-emerald-400 mt-1';
      }
    });

    function calculatePasswordStrength(password) {
      let score = 0;
      if (password.length >= 8) score += 1;
      if (password.length >= 12) score += 1;
      if (/[a-z]/.test(password) && /[A-Z]/.test(password)) score += 1;
      if (/[0-9]/.test(password)) score += 0.5;
      if (/[^a-zA-Z0-9]/.test(password)) score += 0.5;
      return {
        score: Math.min(4, Math.floor(score))
      };
    }
  </script>
</body>
</html>