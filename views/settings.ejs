<% layout('layout') -%>

  <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
    <div>
      <h2 class="text-2xl font-bold">Settings</h2>
      <p class="text-gray-400 text-sm mt-1">Manage your account and preferences</p>
    </div>
  </div>

  <div class="mb-6 border-b border-gray-700">
    <!-- Desktop tabs -->
    <div class="hidden sm:flex flex-wrap -mb-px">
      <button class="settings-tab active mr-2 py-2 px-4 text-primary border-b-2 border-primary font-medium"
        data-tab="profile">
        <i class="ti ti-user mr-2"></i>Profile
      </button>
      <button
        class="settings-tab mr-2 py-2 px-4 text-gray-400 hover:text-white border-b-2 border-transparent hover:border-gray-700 font-medium"
        data-tab="security">
        <i class="ti ti-shield-lock mr-2"></i>Security
      </button>
      <button
        class="settings-tab mr-2 py-2 px-4 text-gray-400 hover:text-white border-b-2 border-transparent hover:border-gray-700 font-medium"
        data-tab="backup">
        <i class="ti ti-database-export mr-2"></i>Backup
      </button>
      <% if (userRole === 'admin') { %>
        <button
          class="settings-tab mr-2 py-2 px-4 text-gray-400 hover:text-white border-b-2 border-transparent hover:border-gray-700 font-medium"
          data-tab="system">
          <i class="ti ti-settings mr-2"></i>System
        </button>
        <button
          class="settings-tab mr-2 py-2 px-4 text-gray-400 hover:text-white border-b-2 border-transparent hover:border-gray-700 font-medium"
          data-tab="branding">
          <i class="ti ti-palette mr-2"></i>Branding
        </button>
        <button
          class="settings-tab mr-2 py-2 px-4 text-gray-400 hover:text-white border-b-2 border-transparent hover:border-gray-700 font-medium"
          data-tab="update">
          <i class="ti ti-refresh mr-2"></i>Update
        </button>
        <% } %>
    </div>

    <!-- Mobile tabs - grid rata kanan kiri -->
    <% if (userRole === 'admin') { %>
      <div class="sm:hidden grid grid-cols-6 -mb-px">
        <% } else { %>
          <div class="sm:hidden grid grid-cols-3 -mb-px">
            <% } %>
              <button
                class="settings-tab active py-3 flex flex-col items-center justify-center text-primary border-b-2 border-primary"
                data-tab="profile">
                <i class="ti ti-user text-lg mb-1"></i>
                <span class="text-xs font-medium">Profile</span>
              </button>
              <button
                class="settings-tab py-3 flex flex-col items-center justify-center text-gray-400 border-b-2 border-transparent"
                data-tab="security">
                <i class="ti ti-shield-lock text-lg mb-1"></i>
                <span class="text-xs font-medium">Security</span>
              </button>
              <button
                class="settings-tab py-3 flex flex-col items-center justify-center text-gray-400 border-b-2 border-transparent"
                data-tab="backup">
                <i class="ti ti-database-export text-lg mb-1"></i>
                <span class="text-xs font-medium">Backup</span>
              </button>
              <% if (userRole === 'admin') { %>
                <button
                  class="settings-tab py-3 flex flex-col items-center justify-center text-gray-400 border-b-2 border-transparent"
                  data-tab="system">
                  <i class="ti ti-settings text-lg mb-1"></i>
                  <span class="text-xs font-medium">System</span>
                </button>
                <button
                  class="settings-tab py-3 flex flex-col items-center justify-center text-gray-400 border-b-2 border-transparent"
                  data-tab="branding">
                  <i class="ti ti-palette text-lg mb-1"></i>
                  <span class="text-xs font-medium">Brand</span>
                </button>
                <button
                  class="settings-tab py-3 flex flex-col items-center justify-center text-gray-400 border-b-2 border-transparent"
                  data-tab="update">
                  <i class="ti ti-refresh text-lg mb-1"></i>
                  <span class="text-xs font-medium">Update</span>
                </button>
                <% } %>
          </div>
      </div>

      <div class="bg-gray-800 rounded-lg overflow-hidden">

        <div id="profile-tab" class="settings-content">
          <div class="p-6">
            <h3 class="text-lg font-semibold mb-6 flex items-center">
              <i class="ti ti-user mr-2 text-primary"></i>
              Profile Settings
            </h3>

            <% if (user.expired_at) {
                 const _e = new Date(user.expired_at);
                 if (!isNaN(_e.getTime())) {
                   const _d = Math.ceil((_e - new Date()) / 86400000);
                   const _ex = _d < 0;
                   const _es = _e.toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' });
            %>
              <div class="mb-6 rounded-2xl border px-4 py-3 flex items-center gap-3 <%= _ex ? 'bg-red-500/10 border-red-500/30' : (_d <= 7 ? 'bg-amber-500/10 border-amber-500/30' : 'bg-dark-700/80 border-gray-700/60') %>">
                <i class="ti <%= _ex ? 'ti-alert-triangle text-red-400' : 'ti-clock-hour-4 text-emerald-400' %> text-2xl flex-shrink-0"></i>
                <div class="flex-1 min-w-0">
                  <% if (_ex) { %>
                    <p class="text-sm font-semibold text-red-400">Akun kedaluwarsa</p>
                    <p class="text-xs text-gray-400">Berakhir <%= _es %>. Live streaming dinonaktifkan, hubungi admin.</p>
                  <% } else { %>
                    <p class="text-sm font-semibold text-white">Masa aktif tersisa <span class="<%= _d <= 7 ? 'text-amber-400' : 'text-emerald-400' %>"><%= _d %> hari lagi</span></p>
                    <p class="text-xs text-gray-400">Aktif sampai <%= _es %></p>
                  <% } %>
                </div>
              </div>
            <%   } } %>

            <form id="profile-form" class="space-y-6 max-w-xl" action="/settings/profile" method="post"
              enctype="multipart/form-data">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="activeTab" value="profile">

              <div class="bg-dark-700/70 border border-gray-700/60 rounded-2xl p-5 space-y-5">
                <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400">Profile Photo</label>
                <div class="flex items-center gap-5">
                  <div class="relative group">
                    <div class="w-20 h-20 rounded-2xl bg-dark-900 overflow-hidden border-2 border-gray-700 shadow-inner flex items-center justify-center">
                      <img id="profile-preview" src="<%= user.avatar_path || '/images/default-avatar.jpg' %>"
                        class="w-full h-full object-cover" alt="Profile Photo"
                        onerror="this.src='/images/default-avatar.jpg'">
                    </div>
                    <label for="profile-upload"
                      class="absolute -bottom-1 -right-1 flex items-center justify-center w-7 h-7 rounded-xl bg-primary hover:bg-secondary cursor-pointer shadow-lg transition-transform hover:scale-110 text-white"
                      title="Upload photo">
                      <i class="ti ti-pencil text-xs"></i>
                    </label>
                    <input id="profile-upload" name="avatar" type="file" accept="image/*" class="hidden">
                  </div>
                  <div class="space-y-2">
                    <button type="button" onclick="document.getElementById('profile-upload').click()"
                      class="px-4 py-2 bg-dark-900 border border-gray-600 hover:bg-dark-600 text-white rounded-xl text-xs font-medium transition-colors flex items-center gap-1.5">
                      <i class="ti ti-upload"></i>
                      <span>Upload New Photo</span>
                    </button>
                    <p class="text-[11px] text-gray-400">PNG, JPG or GIF • Max 2MB</p>
                  </div>
                </div>

                <div class="space-y-1.5 pt-3 border-t border-gray-700/50">
                  <label for="username" class="block text-sm font-medium text-gray-300">Username</label>
                  <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                      <i class="ti ti-user text-base"></i>
                    </span>
                    <input type="text" id="username" name="username"
                      class="w-full bg-dark-900 border border-gray-700/60 text-white pl-10 pr-4 py-2.5 rounded-xl focus:outline-none focus:ring-1 focus:ring-primary text-sm"
                      value="<%= user.username %>">
                  </div>
                </div>
              </div>

              <div class="flex justify-end">
                <button type="submit"
                  class="w-full sm:w-auto px-6 py-2.5 bg-primary hover:bg-secondary text-white rounded-xl transition-all font-medium flex items-center justify-center gap-2 text-sm shadow-md">
                  <i class="ti ti-device-floppy text-base"></i>
                  <span>Save Profile Changes</span>
                </button>
              </div>
            </form>
          </div>
        </div>

        <div id="security-tab" class="settings-content hidden">
          <div class="p-6">
            <h3 class="text-lg font-semibold mb-6 flex items-center">
              <i class="ti ti-shield-lock mr-2 text-primary"></i>
              Security Settings
            </h3>
            <form id="password-form" class="space-y-6 max-w-xl" action="/settings/password" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="activeTab" value="security">

              <div class="bg-dark-700/70 border border-gray-700/60 rounded-2xl p-5 space-y-4">
                <div class="space-y-1.5">
                  <label for="current-password" class="block text-sm font-medium text-gray-300">Current Password</label>
                  <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                      <i class="ti ti-lock text-base"></i>
                    </span>
                    <input type="password" id="current-password" name="currentPassword"
                      class="w-full bg-dark-900 border border-gray-700/60 text-white pl-10 pr-4 py-2.5 rounded-xl focus:outline-none focus:ring-1 focus:ring-primary text-sm"
                      placeholder="Enter your current password">
                  </div>
                </div>

                <div class="space-y-1.5">
                  <label for="new-password" class="block text-sm font-medium text-gray-300">New Password</label>
                  <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                      <i class="ti ti-lock text-base"></i>
                    </span>
                    <input type="password" id="new-password" name="newPassword"
                      class="w-full bg-dark-900 border border-gray-700/60 text-white pl-10 pr-10 py-2.5 rounded-xl focus:outline-none focus:ring-1 focus:ring-primary text-sm"
                      placeholder="Enter new password">
                    <button type="button"
                      class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400 hover:text-white"
                      id="toggle-password">
                      <i class="ti ti-eye"></i>
                    </button>
                  </div>
                </div>

                <div class="space-y-1.5">
                  <label for="confirm-password" class="block text-sm font-medium text-gray-300">Confirm New Password</label>
                  <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                      <i class="ti ti-lock text-base"></i>
                    </span>
                    <input type="password" id="confirm-password" name="confirmPassword"
                      class="w-full bg-dark-900 border border-gray-700/60 text-white pl-10 pr-4 py-2.5 rounded-xl focus:outline-none focus:ring-1 focus:ring-primary text-sm"
                      placeholder="Confirm new password">
                  </div>
                </div>

                <div class="flex items-center gap-2 p-3 bg-dark-900/60 border border-gray-700/50 rounded-xl text-xs text-gray-400">
                  <i class="ti ti-info-circle text-primary text-base flex-shrink-0"></i>
                  <span>Password must be at least 8 characters and include uppercase, lowercase, and a number.</span>
                </div>
              </div>

              <div class="flex justify-end">
                <button type="submit"
                  class="w-full sm:w-auto px-6 py-2.5 bg-primary hover:bg-secondary text-white rounded-xl transition-all font-medium flex items-center justify-center gap-2 text-sm shadow-md">
                  <i class="ti ti-key text-base"></i>
                  <span>Change Password</span>
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Backup & Restore Tab -->
        <div id="backup-tab" class="settings-content hidden">
          <div class="p-6">
            <h3 class="text-lg font-semibold mb-6 flex items-center">
              <i class="ti ti-database-export mr-2 text-primary"></i>
              Backup & Restore
            </h3>

            <div class="space-y-6">
              <!-- Export Section -->
              <div class="bg-dark-700/70 border border-gray-700/60 rounded-2xl p-5 space-y-4">
                <div class="flex items-center justify-between">
                  <h4 class="text-md font-medium flex items-center">
                    <i class="ti ti-download mr-2 text-primary"></i>
                    Export Data
                  </h4>
                </div>
                <p class="text-sm text-gray-400">
                  Export semua data Anda termasuk streams, YouTube credentials, broadcast templates, recurring
                  schedules, stream templates, playlists, title manager, dan thumbnail files.
                </p>
                <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl p-3 flex items-start gap-2.5">
                  <i class="ti ti-info-circle text-amber-400 text-base flex-shrink-0 mt-0.5"></i>
                  <p class="text-xs text-amber-300">
                    <strong>Catatan:</strong> Semua thumbnail files akan di-export sesuai kondisi data Anda. Template mapping tetap ikut di-export.
                  </p>
                </div>

                <div class="space-y-4">
                  <div class="space-y-2">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400">Pilih kategori untuk di-export:</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5">
                      <label class="flex items-center gap-2.5 p-3 rounded-xl bg-dark-900/60 border border-gray-700/50 hover:border-gray-600 transition-colors text-xs text-gray-300 cursor-pointer">
                        <input type="checkbox"
                          class="export-category rounded bg-dark-900 border-gray-600 text-primary focus:ring-primary"
                          value="streams" checked>
                        <span>Streams</span>
                      </label>
                      <label class="flex items-center gap-2.5 p-3 rounded-xl bg-dark-900/60 border border-gray-700/50 hover:border-gray-600 transition-colors text-xs text-gray-300 cursor-pointer">
                        <input type="checkbox"
                          class="export-category rounded bg-dark-900 border-gray-600 text-primary focus:ring-primary"
                          value="youtube_credentials" checked>
                        <span>YouTube Credentials</span>
                      </label>
                      <label class="flex items-center gap-2.5 p-3 rounded-xl bg-dark-900/60 border border-gray-700/50 hover:border-gray-600 transition-colors text-xs text-gray-300 cursor-pointer">
                        <input type="checkbox"
                          class="export-category rounded bg-dark-900 border-gray-600 text-primary focus:ring-primary"
                          value="broadcast_templates" checked>
                        <span>Broadcast Templates</span>
                      </label>
                      <label class="flex items-center gap-2.5 p-3 rounded-xl bg-dark-900/60 border border-gray-700/50 hover:border-gray-600 transition-colors text-xs text-gray-300 cursor-pointer">
                        <input type="checkbox"
                          class="export-category rounded bg-dark-900 border-gray-600 text-primary focus:ring-primary"
                          value="recurring_schedules" checked>
                        <span>Recurring Schedules</span>
                      </label>
                      <label class="flex items-center gap-2.5 p-3 rounded-xl bg-dark-900/60 border border-gray-700/50 hover:border-gray-600 transition-colors text-xs text-gray-300 cursor-pointer">
                        <input type="checkbox"
                          class="export-category rounded bg-dark-900 border-gray-600 text-primary focus:ring-primary"
                          value="stream_templates" checked>
                        <span>Stream Templates</span>
                      </label>
                      <label class="flex items-center gap-2.5 p-3 rounded-xl bg-dark-900/60 border border-gray-700/50 hover:border-gray-600 transition-colors text-xs text-gray-300 cursor-pointer">
                        <input type="checkbox"
                          class="export-category rounded bg-dark-900 border-gray-600 text-primary focus:ring-primary"
                          value="playlists" checked>
                        <span>Playlists</span>
                      </label>
                      <label class="flex items-center gap-2.5 p-3 rounded-xl bg-dark-900/60 border border-gray-700/50 hover:border-gray-600 transition-colors text-xs text-gray-300 cursor-pointer">
                        <input type="checkbox"
                          class="export-category rounded bg-dark-900 border-gray-600 text-primary focus:ring-primary"
                          value="title_folders" checked>
                        <span>Title Folders</span>
                      </label>
                      <label class="flex items-center gap-2.5 p-3 rounded-xl bg-dark-900/60 border border-gray-700/50 hover:border-gray-600 transition-colors text-xs text-gray-300 cursor-pointer">
                        <input type="checkbox"
                          class="export-category rounded bg-dark-900 border-gray-600 text-primary focus:ring-primary"
                          value="title_suggestions" checked>
                        <span>Title Manager</span>
                      </label>
                      <label class="flex items-center gap-2.5 p-3 rounded-xl bg-dark-900/60 border border-gray-700/50 hover:border-gray-600 transition-colors text-xs text-gray-300 cursor-pointer">
                        <input type="checkbox"
                          class="export-category rounded bg-dark-900 border-gray-600 text-primary focus:ring-primary"
                          value="thumbnail_files" checked>
                        <span>Thumbnail Files</span>
                      </label>
                    </div>
                  </div>

                  <div class="flex flex-wrap items-center gap-3 pt-2">
                    <button type="button" id="export-all-btn"
                      class="w-full sm:w-auto px-6 py-2.5 bg-primary hover:bg-secondary text-white rounded-xl font-medium transition-all shadow-md flex items-center justify-center gap-2 text-sm">
                      <i class="ti ti-download text-base"></i>
                      <span>Export Semua Data</span>
                    </button>
                    <button type="button" id="select-all-categories"
                      class="w-full sm:w-auto px-5 py-2.5 bg-dark-900 border border-gray-600 hover:bg-dark-600 text-gray-200 hover:text-white rounded-xl font-medium transition-all flex items-center justify-center gap-2 text-sm">
                      <i class="ti ti-check-double text-base"></i>
                      <span>Pilih Semua</span>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Import Section -->
              <div class="bg-dark-700/70 border border-gray-700/60 rounded-2xl p-5 space-y-4">
                <h4 class="text-md font-medium flex items-center">
                  <i class="ti ti-upload mr-2 text-emerald-400"></i>
                  Import Data
                </h4>
                <p class="text-sm text-gray-400">
                  Restore data dari file backup JSON. Data yang sudah ada dapat di-skip atau di-overwrite.
                </p>

                <form id="import-all-form" enctype="multipart/form-data" class="space-y-4">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                  <div class="space-y-2">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400">File Backup (.json)</label>
                    <input type="file" id="import-file" name="backupFile" accept=".json"
                      class="w-full max-w-lg bg-dark-900 border border-gray-700/60 text-white px-4 py-2 rounded-xl focus:outline-none focus:ring-1 focus:ring-primary text-sm file:mr-4 file:py-1.5 file:px-3.5 file:rounded-lg file:border-0 file:bg-primary file:text-white file:text-xs file:font-medium file:cursor-pointer">
                  </div>

                  <div class="space-y-2">
                    <label class="flex items-center gap-2 text-sm text-gray-300 cursor-pointer">
                      <input type="checkbox" id="skip-duplicates" name="skipDuplicates" checked
                        class="rounded bg-dark-900 border-gray-600 text-primary focus:ring-primary">
                      <span>Skip data duplikat (berdasarkan nama/channel)</span>
                    </label>
                  </div>

                  <!-- Progress Bar -->
                  <div id="import-progress-container" class="hidden space-y-2">
                    <div class="flex justify-between text-sm text-gray-300">
                      <span id="import-progress-message">Memulai import...</span>
                      <span id="import-progress-percentage">0%</span>
                    </div>
                    <div class="w-full bg-dark-900 rounded-full h-2.5 overflow-hidden">
                      <div id="import-progress-bar"
                        class="bg-gradient-to-r from-primary to-blue-500 h-2.5 rounded-full transition-all duration-300"
                        style="width: 0%"></div>
                    </div>
                    <div class="text-xs text-gray-400" id="import-progress-detail">
                      Menunggu...
                    </div>
                  </div>

                  <div class="pt-1">
                    <button type="submit" id="import-all-btn"
                      class="w-full sm:w-auto px-6 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl font-medium transition-all shadow-md flex items-center justify-center gap-2 text-sm">
                      <i class="ti ti-upload text-base"></i>
                      <span>Import Data</span>
                    </button>
                  </div>
                </form>

                <!-- Import Results -->
                <div id="import-results" class="hidden mt-4 p-4 bg-dark-900 rounded-xl border border-gray-700/50">
                  <h5 class="text-sm font-medium text-gray-300 mb-2">Hasil Import:</h5>
                  <div id="import-results-content" class="text-sm text-gray-400"></div>
                </div>
              </div>

              <!-- Legacy Export (Streams Only) -->
              <div class="bg-dark-700/70 border border-gray-700/60 rounded-2xl p-5 space-y-3">
                <h4 class="text-md font-medium flex items-center">
                  <i class="ti ti-broadcast mr-2 text-amber-400"></i>
                  Export Streams Saja (Legacy)
                </h4>
                <p class="text-sm text-gray-400">
                  Export hanya konfigurasi streams untuk kompatibilitas dengan format backup lama.
                </p>
                <div class="pt-1">
                  <a href="/api/streams/export"
                    class="inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-amber-600 hover:bg-amber-500 text-white rounded-xl font-medium transition-all text-sm shadow-md">
                    <i class="ti ti-download text-base"></i>
                    <span>Export Streams</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <% if (userRole === 'admin') { %>
          <div id="system-tab" class="settings-content hidden">
            <div class="p-6">
              <h3 class="text-lg font-semibold mb-6 flex items-center">
                <i class="ti ti-settings mr-2 text-primary"></i>
                System Settings
              </h3>

              <div class="space-y-6">
                <div class="bg-dark-700/70 border border-gray-700/60 rounded-2xl p-5 space-y-4">
                  <h4 class="text-md font-medium flex items-center">
                    <i class="ti ti-broadcast mr-2 text-primary"></i>
                    Live Streaming Limits
                  </h4>
                  <p class="text-sm text-gray-400">
                    Control the maximum number of simultaneous live streams and storage limit per member.
                  </p>

                  <div class="space-y-4 pt-1">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-dark-900/60 border border-gray-700/50">
                      <div>
                        <label for="default-live-limit" class="block text-sm font-medium text-gray-200">
                          Default Live Limit (per member)
                        </label>
                        <p class="text-xs text-gray-400 mt-0.5">
                          Members without a custom limit will use this default value.
                        </p>
                      </div>
                      <div class="flex items-center gap-2.5 self-start sm:self-auto">
                        <input type="number" id="default-live-limit" min="1" max="100" value="1"
                          class="bg-dark-900 border border-gray-700/60 text-white px-3 py-2 rounded-xl w-24 text-center text-sm focus:ring-1 focus:ring-primary">
                        <button type="button" id="save-live-limit"
                          class="px-5 py-2 bg-primary hover:bg-secondary text-white rounded-xl font-medium transition-all text-sm flex items-center gap-1.5 shadow-sm">
                          <i class="ti ti-check"></i>
                          <span>Save</span>
                        </button>
                      </div>
                    </div>

                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-dark-900/60 border border-gray-700/50">
                      <div>
                        <label for="default-storage-limit-value" class="block text-sm font-medium text-gray-200">
                          Default Storage Limit (per member)
                        </label>
                        <p class="text-xs text-gray-400 mt-0.5">
                          Set to 0 for unlimited storage. New members will use this default value.
                        </p>
                        <p class="text-xs text-primary mt-1" id="current-default-storage-limit"></p>
                      </div>
