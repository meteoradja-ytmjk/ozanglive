<%
// Partial: YouTube Studio Component (Embedded in Live Studio)
%>
<style>
  /* Custom scrollbar for thumbnail folder list */
  #thumbnailFolderList::-webkit-scrollbar,
  #tagsContainer::-webkit-scrollbar {
    width: 4px;
  }
  #thumbnailFolderList::-webkit-scrollbar-track,
  #tagsContainer::-webkit-scrollbar-track {
    background: transparent;
  }
  #thumbnailFolderList::-webkit-scrollbar-thumb,
  #tagsContainer::-webkit-scrollbar-thumb {
    background: rgba(107, 114, 128, 0.4);
    border-radius: 2px;
  }
  #thumbnailFolderList::-webkit-scrollbar-thumb:hover,
  #tagsContainer::-webkit-scrollbar-thumb:hover {
    background: rgba(107, 114, 128, 0.6);
  }
  /* Firefox */
  #thumbnailFolderList,
  #tagsContainer {
    scrollbar-width: thin;
    scrollbar-color: rgba(107, 114, 128, 0.4) transparent;
  }

  .thumbnail-manager-highlight {
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.6);
    background: rgba(30, 58, 138, 0.12);
    border-radius: 12px;
    transition: box-shadow 0.3s ease, background 0.3s ease;
  }
  
  /* Better touch responsiveness for buttons */
  .touch-manipulation {
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }
  
  /* Ensure minimum touch target size (48x48px recommended) */
  button.touch-manipulation {
    min-width: 44px;
    min-height: 44px;
  }
</style>

<div class="max-w-6xl mx-auto">
  <!-- Page Header -->
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3 min-w-0">
      <div class="w-10 h-10 bg-red-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
        <i class="ti ti-brand-youtube text-red-500 text-xl"></i>
      </div>
      <div class="min-w-0">
        <h1 class="text-lg sm:text-2xl font-bold truncate">YouTube Sync & Automation</h1>
        <p class="text-xs sm:text-sm text-gray-400 hidden sm:block">Kelola siaran langsung, template, dan otomatisasi akun YouTube</p>
      </div>
    </div>
    <!-- Action Buttons -->
    <div class="flex items-center gap-2 flex-shrink-0">
      <a href="https://console.cloud.google.com/apis/library/youtube.googleapis.com" target="_blank" rel="noopener noreferrer"
        class="bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 active:scale-95 text-white px-2.5 sm:px-4 py-2 sm:py-2.5 rounded-xl text-xs sm:text-sm transition-all duration-150 flex items-center justify-center gap-1.5 font-semibold shadow-lg shadow-red-500/25 cursor-pointer touch-manipulation min-h-[38px] select-none"
        title="Enable YouTube Data API v3 di Google Cloud Console">
        <i class="ti ti-brand-youtube text-base sm:text-lg"></i>
        <span class="hidden sm:inline whitespace-nowrap">Enable API</span>
      </a>
      <button type="button" onclick="openYouTubeGuideModal()" title="Panduan API"
        class="bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 active:scale-95 text-white px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl text-xs sm:text-sm transition-all duration-150 flex items-center justify-center gap-1.5 font-semibold shadow-lg shadow-blue-500/25 cursor-pointer touch-manipulation min-h-[38px] select-none">
        <i class="ti ti-help-circle text-base sm:text-lg"></i>
        <span class="whitespace-nowrap">Panduan API</span>
      </button>
    </div>
  </div>

  <% if (!accounts || accounts.length === 0) { %>
  <!-- Credentials Form (No Accounts Connected) -->
  <div class="bg-gray-800 rounded-lg p-4 sm:p-6 shadow-md">
    <div class="flex items-center gap-3 mb-6">
      <i class="ti ti-key text-primary text-2xl"></i>
      <div>
        <h2 class="text-lg font-semibold">Connect YouTube Account</h2>
        <p class="text-sm text-gray-400">Enter your API credentials to get started</p>
      </div>
    </div>
    
    <form id="credentialsForm" class="space-y-4">
      <div>
        <label class="text-sm font-medium text-white block mb-2">Client ID <span class="text-red-400">*</span></label>
        <input type="text" id="clientId" name="clientId" required
          class="w-full px-4 py-2.5 bg-dark-700 border border-gray-600 rounded-lg focus:border-primary focus:outline-none"
          placeholder="Enter your Google Client ID">
      </div>
      
      <div>
        <label class="text-sm font-medium text-white block mb-2">Client Secret <span class="text-red-400">*</span></label>
        <input type="password" id="clientSecret" name="clientSecret" required
          class="w-full px-4 py-2.5 bg-dark-700 border border-gray-600 rounded-lg focus:border-primary focus:outline-none"
          placeholder="Enter your Google Client Secret">
      </div>
      
      <div>
        <label class="text-sm font-medium text-white block mb-2">Refresh Token <span class="text-red-400">*</span></label>
        <textarea id="refreshToken" name="refreshToken" rows="3" required
          class="w-full px-4 py-2.5 bg-dark-700 border border-gray-600 rounded-lg focus:border-primary focus:outline-none resize-none"
          placeholder="Paste Refresh Token dari OAuth Playground"></textarea>
      </div>
      
      <div class="bg-dark-700 rounded-lg p-4 border border-gray-600">
        <p class="text-sm text-gray-400 break-words">
          <i class="ti ti-info-circle text-primary mr-1"></i>
          Get your credentials from <a href="https://console.cloud.google.com/apis/credentials" target="_blank" class="text-primary hover:underline">Google Cloud Console</a>. 
          Make sure to enable YouTube Data API v3 and add <code class="bg-dark-600 px-1 rounded text-primary text-xs break-all"><%= typeof baseUrl !== 'undefined' ? baseUrl : 'http://localhost:7575' %>/api/youtube/oauth/callback</code> as Authorized Redirect URI.
        </p>
      </div>
      
      <button type="submit" id="connectBtn"
        class="w-full bg-red-500 hover:bg-red-600 text-white px-4 py-3 rounded-lg font-medium transition-colors flex items-center justify-center gap-2">
        <i class="ti ti-brand-youtube flex-shrink-0"></i>
        <span class="whitespace-nowrap">Connect Manual</span>
      </button>
      
      <div class="border-t border-gray-600 pt-4 mt-4">
        <button type="button" onclick="toggleOAuthSection(event)" class="w-full flex items-center justify-between text-gray-400 hover:text-gray-300 transition-colors py-2 touch-manipulation">
          <span class="text-xs font-medium flex items-center gap-2">
            <i class="ti ti-chevron-right text-sm transition-transform duration-200" id="oauthSectionChevron"></i>
            <span>Opsi Lain: Auto-connect via Google</span>
          </span>
          <span class="text-[10px] bg-blue-500/20 text-blue-400 px-2 py-0.5 rounded">Advanced</span>
        </button>
        <div id="oauthSection" class="hidden mt-3">
          <div class="bg-gradient-to-r from-blue-500/10 to-green-500/10 rounded-lg p-4 border border-blue-500/30">
            <p class="text-sm text-blue-300 mb-3 flex items-start gap-2">
              <i class="ti ti-sparkles text-lg flex-shrink-0"></i>
              <span><strong>Recommended:</strong> auto-connect via Google, refresh token otomatis.</span>
            </p>
            <button type="button" onclick="startOAuthFlow()"
              class="w-full bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-4 py-3 rounded-lg font-medium transition-all flex items-center justify-center gap-2 shadow-lg shadow-blue-500/25">
              <i class="ti ti-brand-google text-lg flex-shrink-0"></i>
              <span class="whitespace-nowrap">Connect with Google</span>
            </button>
            <p class="text-xs text-gray-400 mt-2 text-center">Sesi diperbarui otomatis. Publish app ke Production agar koneksi tidak terputus.</p>
          </div>
        </div>
      </div>
    </form>
  </div>
  
  <% } else { %>
  <!-- Connected Accounts & Token Status -->
  <div class="bg-gray-800 rounded-xl border border-gray-700/50 mb-6 overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 min-h-[48px] border-b border-gray-700/50 cursor-pointer hover:bg-gray-700/20 active:bg-gray-700/40 transition-colors select-none"
         onclick="toggleConnectedAccounts()" id="connectedAccountsHeader" role="button" tabindex="0">
      <div class="flex items-center gap-2 pointer-events-none">
        <i class="ti ti-chevron-down text-gray-400 text-base transition-transform duration-200" id="accountsChevron"></i>
        <i class="ti ti-brand-youtube text-red-400 text-base"></i>
        <span class="text-sm font-semibold text-white">Connected Accounts</span>
        <span class="bg-primary/15 text-primary text-xs px-1.5 py-0.5 rounded-md font-medium"><%= accounts.length %></span>
      </div>
      <button onclick="event.stopPropagation(); openAddAccountModal()" 
        class="bg-red-500 hover:bg-red-600 active:bg-red-700 text-white px-3 py-1.5 rounded-lg text-xs transition-colors flex items-center gap-1.5 font-medium pointer-events-auto min-h-[32px]">
        <i class="ti ti-plus text-sm"></i>
        <span>Add</span>
      </button>
    </div>
    
    <div id="connectedAccountsList" class="transition-all duration-200" style="display: none;">
      <% accounts.forEach(function(account, index) { %>
      <div class="flex items-center justify-between px-4 py-2.5 hover:bg-gray-700/30 transition-colors <%= index < accounts.length - 1 ? 'border-b border-gray-700/30' : '' %>">
        <div class="flex items-center gap-3 min-w-0 flex-1">
          <div class="w-8 h-8 bg-red-500/15 rounded-lg flex items-center justify-center flex-shrink-0">
            <i class="ti ti-brand-youtube text-red-400 text-sm"></i>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-white truncate"><%= account.channelName || 'YouTube Channel' %></span>
              <% if (account.isPrimary) { %>
              <span class="px-1.5 py-0.5 bg-yellow-500/15 text-yellow-400 text-[10px] rounded font-medium flex-shrink-0">★ Primary</span>
              <% } %>
            </div>
            <p class="text-[11px] text-green-400/80 flex items-center gap-1 mt-0.5">
              <i class="ti ti-circle-check text-[10px]"></i>
              Connected
            </p>
          </div>
        </div>
        <div class="flex items-center gap-0.5 flex-shrink-0">
          <button onclick="reconnectAccountOAuth(<%= account.id %>, '<%= (account.channelName || 'YouTube Channel').replace(/'/g, "\\'") %>')" 
            class="w-7 h-7 flex items-center justify-center text-gray-500 hover:text-green-400 hover:bg-green-500/10 rounded-md transition-colors" title="Reconnect Token">
            <i class="ti ti-refresh text-sm"></i>
          </button>
          <button onclick="openEditAccountModal(<%= account.id %>, '<%= (account.channelName || 'YouTube Channel').replace(/'/g, "\\'") %>')" 
            class="w-7 h-7 flex items-center justify-center text-gray-500 hover:text-blue-400 hover:bg-blue-500/10 rounded-md transition-colors" title="Edit">
            <i class="ti ti-edit text-sm"></i>
          </button>
          <button onclick="setPrimaryAccount(<%= account.id %>)" 
            class="w-7 h-7 flex items-center justify-center rounded-md transition-colors <%= account.isPrimary ? 'text-yellow-400' : 'text-gray-500 hover:text-yellow-400 hover:bg-yellow-500/10' %>" title="<%= account.isPrimary ? 'Primary' : 'Set Primary' %>">
            <i class="ti <%= account.isPrimary ? 'ti-star-filled' : 'ti-star' %> text-sm"></i>
          </button>
          <button onclick="disconnectAccount(<%= account.id %>, '<%= (account.channelName || 'this account').replace(/'/g, "\\'") %>')" 
            class="w-7 h-7 flex items-center justify-center text-gray-500 hover:text-red-400 hover:bg-red-500/10 rounded-md transition-colors" title="Disconnect">
            <i class="ti ti-unlink text-sm"></i>
          </button>
        </div>
      </div>
      <% }); %>
    </div>
  </div>

  <% 
  const expiredAccounts = accounts.filter(a => {
    return a.tokenStatus === 'expired' || a.tokenStatus === 'error';
  });
  
  if (expiredAccounts.length > 0) { 
  %>
  <div id="expiredTokenAlert" class="bg-gradient-to-r from-red-500/10 via-red-500/5 to-transparent border-l-4 border-red-500 rounded-xl mb-6 shadow-xl overflow-hidden backdrop-blur-sm">
    <div class="hidden md:block">
      <div class="flex items-center justify-between px-6 py-4">
        <div class="flex items-center gap-4 flex-1">
          <div class="relative">
            <div class="w-14 h-14 bg-gradient-to-br from-red-500/30 to-red-600/30 rounded-2xl flex items-center justify-center backdrop-blur-sm">
              <i class="ti ti-alert-circle text-red-400 text-3xl"></i>
            </div>
            <div class="absolute -top-1 -right-1 w-6 h-6 bg-red-500 rounded-full flex items-center justify-center text-white text-xs font-bold animate-pulse">
              <%= expiredAccounts.length %>
            </div>
          </div>
          <div class="flex-1">
            <h3 class="text-white font-bold text-lg mb-1 flex items-center gap-2">
              Token Expired - Perlu Reconnect
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              OAuth app mode <span class="text-red-400 font-semibold">"Testing"</span> - token expired setiap 7 hari. 
              <a href="https://console.cloud.google.com/apis/credentials/consent" target="_blank" class="text-blue-400 hover:text-blue-300 underline decoration-dotted underline-offset-2 ml-1 transition-colors">
                Publish ke Production untuk solusi permanent →
              </a>
            </p>
            <p class="text-gray-500 text-xs mt-1">
              <i class="ti ti-bulb text-yellow-500/70 mr-0.5"></i>
              Reconnect = perbaikan cepat (bertahan 7 hari). Publish ke Production = solusi permanen.
            </p>
            <div class="flex flex-wrap gap-2 mt-3">
              <% expiredAccounts.forEach(function(account) { %>
              <span class="inline-flex items-center gap-1.5 bg-red-500/20 text-red-300 px-3 py-1 rounded-full text-xs font-medium border border-red-500/30">
                <i class="ti ti-circle-x text-xs"></i>
                <%= account.channelName || 'Account #' + account.id %>
              </span>
              <% }); %>
            </div>
          </div>
        </div>
        
        <div class="flex items-center gap-3 ml-6">
          <button onclick="reconnectAllExpired()" 
            class="bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white px-6 py-3 rounded-xl font-semibold transition-all duration-200 flex items-center gap-2 shadow-lg shadow-red-500/25 hover:shadow-red-500/40 hover:scale-105 active:scale-95">
            <i class="ti ti-refresh text-lg"></i>
            <span>Reconnect Sekarang</span>
          </button>
          <button onclick="dismissExpiredAlertWithBadge()" 
            class="text-gray-400 hover:text-white hover:bg-gray-700/50 w-10 h-10 flex items-center justify-center rounded-lg transition-all">
            <i class="ti ti-x text-xl"></i>
          </button>
        </div>
      </div>
    </div>

    <div class="md:hidden">
      <div class="flex items-center justify-between px-4 py-3">
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <div class="relative">
            <div class="w-11 h-11 bg-gradient-to-br from-red-500/30 to-red-600/30 rounded-xl flex items-center justify-center">
              <i class="ti ti-alert-circle text-red-400 text-xl"></i>
            </div>
            <div class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 rounded-full flex items-center justify-center text-white text-[10px] font-bold animate-pulse">
              <%= expiredAccounts.length %>
            </div>
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="text-white font-bold text-sm">
              Token Expired
            </h3>
            <p class="text-gray-500 text-xs">Perlu reconnect sekarang</p>
          </div>
        </div>
        <button onclick="dismissExpiredAlertWithBadge()" 
          class="text-gray-500 hover:text-gray-300 transition-colors flex-shrink-0 w-8 h-8 flex items-center justify-center rounded hover:bg-gray-700/30">
          <i class="ti ti-x text-lg"></i>
        </button>
      </div>
      
      <div class="px-4 pb-4">
        <p class="text-gray-400 text-xs leading-relaxed mb-3">
          OAuth mode Testing - expired setiap 7 hari. 
          <a href="https://console.cloud.google.com/apis/credentials/consent" target="_blank" class="text-blue-400 underline">
            Publish ke Production →
          </a>
        </p>
        
        <button onclick="reconnectAllExpired()" 
          class="w-full bg-gradient-to-r from-red-500 to-red-600 active:from-red-600 active:to-red-700 text-white px-4 py-3 rounded-xl font-bold transition-all duration-200 flex items-center justify-center gap-2 shadow-lg text-sm">
          <i class="ti ti-refresh text-base"></i>
          <span>Reconnect Sekarang</span>
        </button>
        
        <div class="mt-3 pt-3 border-t border-red-500/20">
          <p class="text-[10px] text-gray-500 mb-2 font-medium uppercase tracking-wide">Akun yang expired:</p>
          <div class="flex flex-wrap gap-1.5">
            <% expiredAccounts.forEach(function(account) { %>
            <span class="inline-flex items-center gap-1 bg-red-500/20 text-red-300 px-2 py-0.5 rounded-full text-[10px] font-medium border border-red-500/30">
              <i class="ti ti-circle-x" style="font-size: 8px;"></i>
              <%= account.channelName || '#' + account.id %>
            </span>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="expiredTokenBadge" class="hidden bg-red-500/10 border border-red-500/50 rounded-lg px-4 py-2 mb-6 cursor-pointer hover:bg-red-500/20 transition-all" onclick="showExpiredAlert()">
    <div class="flex items-center gap-3">
      <div class="relative">
        <i class="ti ti-alert-circle text-red-400 text-xl"></i>
        <div class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full flex items-center justify-center text-white text-[9px] font-bold">
          <%= expiredAccounts.length %>
        </div>
      </div>
      <span class="text-sm text-gray-300">
        <span class="font-semibold text-red-400"><%= expiredAccounts.length %> akun</span> perlu reconnect
      </span>
      <i class="ti ti-chevron-down text-gray-500 text-sm ml-auto"></i>
    </div>
  </div>
  <% } %>

  <!-- Token Auto-Refresh Status -->
  <div class="bg-gray-800 rounded-xl border border-gray-700/50 mb-6 overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 min-h-[48px] cursor-pointer hover:bg-gray-700/20 active:bg-gray-700/40 transition-colors select-none"
         onclick="toggleTokenStatus()" id="tokenStatusHeader" role="button" tabindex="0">
      <div class="flex items-center gap-2 pointer-events-none">
        <i class="ti ti-chevron-right text-gray-400 text-base transition-transform duration-200" id="tokenChevron"></i>
        <i class="ti ti-shield-check text-green-400 text-base"></i>
        <span class="text-sm font-semibold text-white">Token Auto-Refresh</span>
        <span class="bg-green-500/15 text-green-400 text-[10px] px-1.5 py-0.5 rounded-md font-medium">AUTO</span>
      </div>
      <span class="text-[11px] text-gray-500 pointer-events-none hidden sm:inline">Refresh otomatis setiap 4-5 hari</span>
    </div>
    <div id="tokenStatusContent" class="px-4 pb-4" style="display: none;">
      <div class="border-t border-gray-700/30 pt-3">
        <div class="bg-blue-500/5 border border-blue-500/20 rounded-lg p-3 mb-3">
          <p class="text-xs text-gray-400 leading-relaxed">
            <i class="ti ti-info-circle text-blue-400 mr-1"></i>
            Yang diperbarui otomatis adalah <span class="text-gray-300">sesi login (access token)</span>. Jika OAuth app masih mode <span class="text-orange-400">Testing</span>, Google tetap memutus koneksi tiap 7 hari —
            <a href="https://console.cloud.google.com/apis/credentials/consent" target="_blank" class="text-blue-400 hover:underline">publish ke Production</a> untuk solusi permanen.
          </p>
        </div>
        <div id="tokenStatusContainer">
          <div class="flex items-center justify-center py-3">
            <i class="ti ti-loader animate-spin text-gray-400 mr-2 text-sm"></i>
            <span class="text-xs text-gray-400">Loading token status...</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Live Stats Dashboard -->
  <div id="liveStatsDashboard" class="bg-gray-800 rounded-xl px-3 py-2 shadow-lg border border-gray-700/50 mb-6 live-stats-dashboard overflow-hidden">
    <div class="hidden md:flex items-center gap-2 live-stats-desktop">
      <div class="flex-1 flex items-center gap-2 live-stats-group">
        <div class="live-stat-chip" title="Active Broadcasts">
          <i class="ti ti-broadcast text-purple-400"></i>
          <span id="liveCountNum" class="text-white font-bold">0</span>
          <span class="text-gray-400 text-xs">live</span>
        </div>
        <div class="live-stat-chip" title="API Quota">
          <i class="ti ti-api text-cyan-400"></i>
          <span id="quotaUsed" class="text-white font-bold">10K</span>
          <span id="quotaChannelName" class="text-gray-400 text-xs"></span>
        </div>
        <div class="live-stat-chip" title="Total Viewers">
          <i class="ti ti-users text-yellow-400"></i>
          <span id="totalViewers" class="text-white font-bold">0</span>
          <span class="text-gray-400 text-xs">viewers</span>
        </div>
        <div class="live-stat-chip" title="Connection Status">
          <i class="ti ti-wifi text-green-400" id="connectionIcon"></i>
          <span id="connectionLabel" class="text-green-400 font-semibold text-xs">Online</span>
        </div>
      </div>
      <div class="flex items-center gap-1.5 flex-shrink-0">
        <button onclick="refreshLiveStats()" id="refreshStatsBtn" class="live-stat-action" title="Refresh">
          <i class="ti ti-refresh" id="refreshIcon"></i>
        </button>
        <button onclick="toggleAutoRefresh()" id="autoRefreshBtn" class="live-stat-action" title="Auto refresh">
          <i class="ti ti-clock" id="autoRefreshIcon"></i>
          <span id="autoRefreshLabel" class="live-stat-toggle-label">OFF</span>
        </button>
      </div>
    </div>
    
    <div class="md:hidden">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-5">
          <div class="flex items-center gap-1.5" title="Active Broadcasts">
            <i class="ti ti-broadcast text-purple-400 text-base"></i>
            <span id="liveCountNumMobile" class="text-white font-semibold">0</span>
            <span class="text-gray-500 text-sm">live</span>
          </div>
          <div class="flex items-center gap-1.5" title="API Quota">
            <i class="ti ti-api text-cyan-400 text-base"></i>
            <span id="quotaUsedMobile" class="text-white font-semibold">10K</span>
          </div>
          <div class="flex items-center gap-1.5" title="Total Viewers">
            <i class="ti ti-users text-yellow-400 text-base"></i>
            <span id="totalViewersMobile" class="text-white font-semibold">0</span>
          </div>
          <div class="flex items-center" title="Connection Status">
            <i class="ti ti-wifi text-green-400 text-base" id="connectionIconMobile"></i>
          </div>
        </div>
        <div class="flex items-center gap-1">
          <button onclick="refreshLiveStats()" id="refreshStatsBtnMobile" class="p-1.5 hover:bg-dark-700 rounded transition-colors" title="Refresh">
            <i class="ti ti-refresh text-gray-400 text-base" id="refreshIconMobile"></i>
          </button>
          <button onclick="toggleAutoRefresh()" id="autoRefreshBtnMobile" class="p-1.5 hover:bg-dark-700 rounded transition-colors flex items-center gap-1" title="Auto">
            <i class="ti ti-clock text-gray-400 text-base" id="autoRefreshIconMobile"></i>
            <span id="autoRefreshLabelMobile" class="text-xs text-gray-500">OFF</span>
          </button>
