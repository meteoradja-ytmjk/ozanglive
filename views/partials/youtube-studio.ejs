  <!-- Broadcasts List -->
  <% if (broadcasts === null) { %>
  <div id="broadcastsLoadingContainer" class="bg-gray-800 rounded-lg p-10 text-center">
    <div class="w-16 h-16 bg-dark-700 rounded-full flex items-center justify-center mx-auto mb-4">
      <i class="ti ti-loader animate-spin text-primary text-2xl"></i>
    </div>
    <p class="text-gray-400 font-medium mb-2">Loading broadcasts...</p>
    <p class="text-gray-500 text-sm">Fetching data from YouTube API</p>
    <div class="mt-4">
      <div class="w-48 h-1.5 bg-dark-700 rounded-full mx-auto overflow-hidden">
        <div class="h-full bg-gradient-to-r from-primary to-blue-500 rounded-full animate-pulse" style="width: 60%"></div>
      </div>
    </div>
