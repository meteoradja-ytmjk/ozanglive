<!-- Auto-Pilot Campaign Modal -->
<div id="autoPilotCampaignModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden modal-overlay overflow-y-auto">
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="bg-dark-800 border border-gray-700/80 rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden">
      <div class="flex items-center justify-between p-5 bg-gradient-to-r from-emerald-500/20 via-teal-500/10 to-transparent border-b border-gray-700">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-emerald-500/20 rounded-xl flex items-center justify-center text-emerald-400">
            <i class="ti ti-robot text-2xl"></i>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              Auto-Pilot Campaign Studio
              <span class="text-[10px] bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded-md font-semibold uppercase">Sekali Setting</span>
            </h3>
            <p class="text-xs text-gray-400">Setel siaran otomatis 1-klik yang berjalan terus selamanya</p>
          </div>
        </div>
        <button onclick="closeAutoPilotCampaignModal()" class="text-gray-400 hover:text-white p-2 rounded-lg hover:bg-dark-700 transition-colors">
          <i class="ti ti-x text-xl"></i>
        </button>
      </div>

      <form id="autoPilotCampaignForm" onsubmit="submitAutoPilotCampaign(event)" class="p-6 space-y-5">
        <!-- 1. YouTube Account (WAJIB) -->
        <div class="bg-dark-700/40 p-4 rounded-xl border border-gray-700/60">
          <label class="text-sm font-semibold text-white mb-2 flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-red-500/20 text-red-400 text-xs flex items-center justify-center font-bold">1</span>
            Akun YouTube Target <span class="text-red-400">*</span>
          </label>
          <select id="autoPilotAccountId" name="accountId" required
            class="w-full px-4 py-2.5 bg-dark-700 border border-gray-600 rounded-lg focus:border-emerald-500 focus:outline-none text-sm text-white">
            <% if (accounts && accounts.length > 0) { %>
              <% accounts.forEach(function(account) { %>
              <option value="<%= account.id %>"><%= account.channelName || 'YouTube Channel #' + account.id %></option>
              <% }); %>
            <% } else { %>
              <option value="">-- Hubungkan Akun YouTube Terlebih Dahulu --</option>
            <% } %>
          </select>
        </div>

        <!-- 2. Video Source (WAJIB) -->
        <div class="bg-dark-700/40 p-4 rounded-xl border border-gray-700/60">
          <label class="text-sm font-semibold text-white mb-2 flex items-center justify-between">
            <span class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-violet-500/20 text-violet-400 text-xs flex items-center justify-center font-bold">2</span>
              Sumber Video <span class="text-red-400">*</span>
            </span>
            <span class="text-xs text-violet-400 font-medium">Single / Playlist / Folder</span>
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
            <div>
              <label class="text-xs text-gray-400 block mb-1">Tipe Video</label>
              <select id="autoPilotVideoType" name="videoType" onchange="onAutoPilotVideoTypeChange(this.value)" required
                class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg focus:border-emerald-500 focus:outline-none text-xs text-white">
                <option value="single">Video Galeri (Tunggal)</option>
                <option value="playlist">Playlist Video</option>
                <option value="folder">Folder Galeri Video</option>
              </select>
            </div>
            <div>
              <label class="text-xs text-gray-400 block mb-1">Pilih Item Video</label>
              <select id="autoPilotVideoSelect" name="videoId" required
                class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg focus:border-emerald-500 focus:outline-none text-xs text-white">
                <option value="">Loading video list...</option>
              </select>
            </div>
          </div>
        </div>

        <!-- 3. Audio Source (WAJIB) -->
        <div class="bg-dark-700/40 p-4 rounded-xl border border-gray-700/60">
          <label class="text-sm font-semibold text-white mb-2 flex items-center justify-between">
            <span class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 text-xs flex items-center justify-center font-bold">3</span>
              Sumber Audio <span class="text-red-400">*</span>
            </span>
            <span class="text-xs text-cyan-400 font-medium">Bawaan / Custom MP3 / Audio Playlist</span>
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="text-xs text-gray-400 block mb-1">Tipe Audio</label>
              <select id="autoPilotAudioType" name="audioType" onchange="onAutoPilotAudioTypeChange(this.value)" required
                class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg focus:border-emerald-500 focus:outline-none text-xs text-white">
                <option value="original">Audio Bawaan Video (Default)</option>
                <option value="single_audio">File Audio MP3/WAV</option>
                <option value="audio_playlist">Playlist Audio</option>
              </select>
            </div>
            <div id="autoPilotAudioSelectContainer" class="hidden">
              <label class="text-xs text-gray-400 block mb-1">Pilih Item Audio</label>
              <select id="autoPilotAudioSelect" name="audioId"
                class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg focus:border-emerald-500 focus:outline-none text-xs text-white">
                <option value="">-- Pilih Audio --</option>
              </select>
            </div>
          </div>
        </div>

        <!-- 4. Smart Rotator Manager (WAJIB) -->
        <div class="bg-dark-700/40 p-4 rounded-xl border border-gray-700/60">
          <label class="text-sm font-semibold text-white mb-2 flex items-center justify-between">
            <span class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-400 text-xs flex items-center justify-center font-bold">4</span>
              Smart Rotator Manager <span class="text-red-400">*</span>
            </span>
            <span class="text-xs text-amber-400 font-medium">Auto-Rotate Title & Thumbnail</span>
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="text-xs text-gray-400 block mb-1">Folder Rotasi Judul <span class="text-red-400">*</span></label>
              <select id="autoPilotTitleFolderId" name="titleFolderId" required
                class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg focus:border-emerald-500 focus:outline-none text-xs text-white">
                <option value="">Loading title folders...</option>
              </select>
            </div>
            <div>
              <label class="text-xs text-gray-400 block mb-1">Folder Rotasi Thumbnail <span class="text-red-400">*</span></label>
              <select id="autoPilotThumbnailFolderId" name="thumbnailFolderId" required
                class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg focus:border-emerald-500 focus:outline-none text-xs text-white">
                <option value="">Loading thumbnail folders...</option>
              </select>
            </div>
          </div>
        </div>

        <!-- 5. Schedule Pattern (WAJIB) -->
        <div class="bg-dark-700/40 p-4 rounded-xl border border-gray-700/60">
          <label class="text-sm font-semibold text-white mb-2 flex items-center justify-between">
            <span class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 text-xs flex items-center justify-center font-bold">5</span>
              Pola Jadwal Otomatis <span class="text-red-400">*</span>
            </span>
            <span class="text-xs text-emerald-400 font-medium">Jalan Terus Selamanya</span>
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-3">
            <div>
              <label class="text-xs text-gray-400 block mb-1">Tipe Jadwal</label>
              <select id="autoPilotScheduleType" name="scheduleType" onchange="onAutoPilotScheduleTypeChange(this.value)" required
                class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg focus:border-emerald-500 focus:outline-none text-xs text-white">
                <option value="247">24/7 Nonstop Loop</option>
                <option value="daily">Rutin Harian (Daily)</option>
                <option value="weekly">Rutin Mingguan (Weekly)</option>
              </select>
            </div>
            <div id="autoPilotTimeContainer" class="hidden">
              <label class="text-xs text-gray-400 block mb-1">Jam Tayang (WIB)</label>
              <input type="time" id="autoPilotScheduleTime" name="scheduleTime" value="08:00"
                class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg focus:border-emerald-500 focus:outline-none text-xs text-white [color-scheme:dark]">
            </div>
            <div id="autoPilotDurationContainer" class="hidden">
              <label class="text-xs text-gray-400 block mb-1">Durasi Stream (Menit)</label>
              <input type="number" id="autoPilotDuration" name="duration" min="15" value="120" placeholder="120"
                class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg focus:border-emerald-500 focus:outline-none text-xs text-white">
            </div>
          </div>
        </div>

        <!-- Privacy & Replay Settings -->
        <div class="flex items-center justify-between p-3 bg-dark-700/30 rounded-xl border border-gray-700/40 text-xs">
          <div class="flex items-center gap-2 text-gray-300">
            <i class="ti ti-eye-off text-emerald-400 text-base"></i>
            <span>Unlist video replay otomatis setelah siaran selesai</span>
          </div>
          <input type="checkbox" id="autoPilotUnlistReplay" name="unlistReplayOnEnd" value="true" checked class="w-4 h-4 rounded text-emerald-500 border-gray-600 bg-dark-700 focus:ring-emerald-500">
        </div>

        <!-- Submit Button -->
        <button type="submit" id="submitAutoPilotBtn"
          class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg shadow-emerald-500/25 transition-all flex items-center justify-center gap-2 text-sm">
          <i class="ti ti-rocket text-lg"></i>
          <span>LAUNCH AUTO-PILOT CAMPAIGN</span>
        </button>
      </form>
    </div>
  </div>
</div>

<!-- YouTube API Guide Modal -->
<div id="youtubeGuideModal" class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 hidden modal-overlay overflow-y-auto" onclick="if(event.target === this) closeYouTubeGuideModal()">
  <div class="flex min-h-screen items-center justify-center p-3 sm:p-4">
    <div class="bg-dark-800 border border-gray-700/80 rounded-2xl shadow-2xl w-full max-w-3xl overflow-hidden transition-all transform" onclick="event.stopPropagation()">
      <!-- Modal Header -->
      <div class="flex items-center justify-between p-4 sm:p-5 bg-gradient-to-r from-blue-600/20 via-indigo-600/10 to-transparent border-b border-gray-700/80">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 bg-blue-500/20 rounded-xl flex items-center justify-center text-blue-400 flex-shrink-0">
            <i class="ti ti-brand-youtube text-2xl"></i>
          </div>
          <div class="min-w-0">
            <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2 truncate">
              Panduan Integrasi YouTube Data API v3
              <span class="text-[10px] bg-blue-500/20 text-blue-400 px-2 py-0.5 rounded-md font-semibold uppercase hidden sm:inline">Panduan Lengkap</span>
            </h3>
            <p class="text-xs text-gray-400 truncate">Petunjuk setup Client ID, OAuth Redirect URI, status Production & kuota API</p>
          </div>
        </div>
        <button type="button" onclick="closeYouTubeGuideModal()" 
          class="text-gray-400 hover:text-white p-2 rounded-xl hover:bg-dark-700/80 transition-colors flex-shrink-0 cursor-pointer touch-manipulation active:scale-95" title="Tutup">
          <i class="ti ti-x text-xl"></i>
        </button>
      </div>

      <!-- Navigation Tabs inside Modal -->
      <div class="flex border-b border-gray-700/60 bg-dark-900/40 px-4 pt-2 gap-2 overflow-x-auto scrollbar-none">
        <button type="button" onclick="switchGuideTab('setup')" id="guide-tab-btn-setup"
          class="guide-tab-btn px-4 py-2.5 text-xs sm:text-sm font-semibold rounded-t-xl border-b-2 border-blue-500 text-blue-400 flex items-center gap-2 transition-all whitespace-nowrap cursor-pointer touch-manipulation">
          <i class="ti ti-rocket text-base"></i>
          <span>1. Quick Setup</span>
        </button>
        <button type="button" onclick="switchGuideTab('production')" id="guide-tab-btn-production"
          class="guide-tab-btn px-4 py-2.5 text-xs sm:text-sm font-semibold rounded-t-xl border-b-2 border-transparent text-gray-400 hover:text-white flex items-center gap-2 transition-all whitespace-nowrap cursor-pointer touch-manipulation">
          <i class="ti ti-shield-check text-base"></i>
          <span>2. Solusi Token Expired (Production)</span>
        </button>
        <button type="button" onclick="switchGuideTab('quota')" id="guide-tab-btn-quota"
          class="guide-tab-btn px-4 py-2.5 text-xs sm:text-sm font-semibold rounded-t-xl border-b-2 border-transparent text-gray-400 hover:text-white flex items-center gap-2 transition-all whitespace-nowrap cursor-pointer touch-manipulation">
          <i class="ti ti-api text-base"></i>
          <span>3. Kuota API & Optimasi</span>
        </button>
      </div>

      <!-- Modal Body Content -->
      <div class="p-4 sm:p-6 space-y-4 max-h-[70vh] overflow-y-auto custom-scrollbar">
        <!-- Tab 1: Quick Setup -->
        <div id="guide-panel-setup" class="guide-panel space-y-4">
          <div class="bg-blue-500/10 border border-blue-500/30 rounded-xl p-4 flex items-start gap-3">
            <i class="ti ti-info-circle text-blue-400 text-xl flex-shrink-0 mt-0.5"></i>
            <div class="text-xs sm:text-sm text-gray-300 leading-relaxed">
              <span class="font-bold text-white">Ingin cara tercepat?</span> Anda hanya perlu **Client ID** dan **Client Secret** dari Google Cloud Console. Setelah itu gunakan fitur <span class="text-blue-400 font-semibold">1-Click Connect with Google</span>.
            </div>
          </div>

          <div class="space-y-3">
            <!-- Step 1 -->
            <div class="bg-dark-700/50 rounded-xl p-4 border border-gray-700/60">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 rounded-full bg-red-500/20 text-red-400 text-xs font-bold flex items-center justify-center">1</span>
                <h4 class="text-sm font-bold text-white">Aktifkan YouTube Data API v3</h4>
              </div>
              <p class="text-xs text-gray-300 ml-8 leading-relaxed mb-3">
                Buka Google Cloud Console, pilih project Anda (atau buat project baru), lalu aktifkan library API YouTube.
              </p>
              <div class="ml-8">
                <a href="https://console.cloud.google.com/apis/library/youtube.googleapis.com" target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-3 py-1.5 bg-red-500/20 hover:bg-red-500/30 text-red-400 border border-red-500/30 rounded-lg text-xs font-medium transition-all active:scale-95">
                  <i class="ti ti-external-link"></i>
                  <span>Buka Page YouTube Data API v3</span>
                </a>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="bg-dark-700/50 rounded-xl p-4 border border-gray-700/60">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 rounded-full bg-blue-500/20 text-blue-400 text-xs font-bold flex items-center justify-center">2</span>
                <h4 class="text-sm font-bold text-white">Buat Credentials (OAuth Client ID) & Tambah Redirect URI</h4>
              </div>
              <p class="text-xs text-gray-300 ml-8 leading-relaxed mb-2">
                Masuk ke menu <strong>Credentials > Create Credentials > OAuth Client ID</strong>. Pilih tipe <strong>Web Application</strong>.
              </p>
              <div class="ml-8 space-y-2">
                <p class="text-xs text-gray-400">Tambahkan URL berikut ke kolom <strong>Authorized redirect URIs</strong>:</p>
                <div class="flex items-center gap-2 bg-dark-900/90 p-2.5 rounded-lg border border-gray-700/80 font-mono text-xs">
                  <span id="guideRedirectUriText" class="text-blue-300 select-all truncate flex-1">http://localhost:7575/api/youtube/oauth/callback</span>
                  <button type="button" onclick="copyGuideRedirectUri()" 
                    class="px-2.5 py-1 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white rounded text-[11px] font-sans font-medium flex items-center gap-1 transition-all active:scale-95 cursor-pointer touch-manipulation">
                    <i class="ti ti-copy text-xs" id="copyUriIcon"></i>
                    <span id="copyUriText">Copy</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="bg-dark-700/50 rounded-xl p-4 border border-gray-700/60">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold flex items-center justify-center">3</span>
                <h4 class="text-sm font-bold text-white">Koneksikan Akun di StreamFlow</h4>
              </div>
              <p class="text-xs text-gray-300 ml-8 leading-relaxed">
                Copy <strong>Client ID</strong> dan <strong>Client Secret</strong> lalu tempelkan pada form <strong>Connect YouTube Account</strong>, lalu klik <strong>Connect with Google</strong>. Anda akan di-redirect untuk konfirmasi izin channel YouTube.
              </p>
            </div>
          </div>
        </div>

