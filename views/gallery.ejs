        <div class="media-drop-target bg-dark-750/90 hover:bg-dark-700/90 rounded-xl p-2.5 sm:p-3 flex items-center justify-between cursor-pointer transition-all border border-gray-700/60 shadow-sm" onclick="toggleAudioGroup('<%= groupIndex %>')" data-media-type="audio" data-folder-name="<%= group.displayName %>">
