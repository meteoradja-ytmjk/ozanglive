<!-- Audio List -->
<div id="audioGrid" class="flex flex-col gap-3 <%= activeTab === 'audio' ? 'tab-visible' : 'tab-hidden' %>">
  <% if (audios && audios.length > 0) { %>
    <% 
    // Separate explicit user folders from standalone audios
    const audioFoldersByName = {};
    const standaloneAudios = [];
    
    audios.forEach(function(audio) {
      const explicitFolder = (audio.folder_name || '').trim();
      if (explicitFolder) {
        const baseKey = explicitFolder.toLowerCase();
        if (!audioFoldersByName[baseKey]) {
          audioFoldersByName[baseKey] = {
            displayName: explicitFolder,
            audios: []
          };
        }
        audioFoldersByName[baseKey].audios.push(audio);
      } else {
        standaloneAudios.push(audio);
      }
    });
    
    // Sort folder groups by most recent audio
    const audioFolderKeys = Object.keys(audioFoldersByName).sort((a, b) => {
      const latestA = Math.max(...audioFoldersByName[a].audios.map(v => new Date(v.upload_date)));
      const latestB = Math.max(...audioFoldersByName[b].audios.map(v => new Date(v.upload_date)));
      return latestB - latestA;
    });
    %>

    <!-- Real Folders (only shown if user created/moved into folders) -->
    <% audioFolderKeys.forEach(function(groupKey, groupIndex) { 
      const group = audioFoldersByName[groupKey];
      const groupAudios = group.audios.sort((a, b) => new Date(b.upload_date) - new Date(a.upload_date));
    %>
      <div class="audio-group" data-name="<%= groupKey %>" data-audio-ids='<%- JSON.stringify(groupAudios.map(a => a.id)) %>'>
