<% layout('layout') -%>
<% 
function formatFileSize(bytes) { 
  if (bytes < 1024) return bytes + ' B'; 
  else if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB'; 
  else if (bytes < 1073741824) return (bytes / 1048576).toFixed(1) + ' MB'; 
  else return (bytes / 1073741824).toFixed(1) + ' GB'; 
} 
function formatDuration(seconds) { 
  if (!seconds) return '00:00'; 
  const minutes = Math.floor(seconds / 60); 
  const remainingSeconds = Math.floor(seconds % 60); 
  return `${minutes.toString().padStart(2, '0')}:${remainingSeconds.toString().padStart(2, '0')}`; 
} 
%>

<style>
  .tab-hidden { display: none !important; }
  .tab-visible { display: flex !important; }
  /* Group collapse animations */
  .video-group-content, .audio-group-content {
    overflow: visible;
    transition: all 0.3s ease-in-out;
  }
  
  /* Mobile 3-dots action menu styling & animations */
  .card-action-menu {
    animation: menuFadeIn 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: top right;
  }
  .card-action-menu.bottom-full {
    transform-origin: bottom right;
  }
  @keyframes menuFadeIn {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(-4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
  .card-action-menu.bottom-full {
    animation-name: menuFadeInUp;
  }
  @keyframes menuFadeInUp {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
  
  .video-group:hover .bg-gray-800\/50,
  .audio-group:hover .bg-gray-800\/50 {
    background-color: rgba(31, 41, 55, 0.7);
  }
  
  /* Smooth icon rotation */
  .ti-chevron-down {
    transition: transform 0.2s ease-in-out;
  }
  
  /* Group header styling */
  .video-group > div:first-child,
  .audio-group > div:first-child {
    user-select: none;
  }

  .video-card[draggable="true"],
  .audio-card[draggable="true"] {
    cursor: grab;
  }

  .video-card.dragging,
  .audio-card.dragging {
    opacity: 0.55;
    transform: scale(0.99);
  }

  .media-drop-target {
    outline: 2px dashed transparent;
    outline-offset: 3px;
  }

  .media-drop-target.drag-over {
    outline-color: rgba(139, 92, 246, 0.9);
    background-color: rgba(139, 92, 246, 0.16);
  }

  .audio-group .media-drop-target.drag-over {
    outline-color: rgba(34, 197, 94, 0.9);
    background-color: rgba(34, 197, 94, 0.14);
  }

  /* Grid View Mode */
  .view-mode-grid .video-group-content:not([style*="display: none"]),
  .view-mode-grid .audio-group-content:not([style*="display: none"]),
  .view-mode-grid .standalone-media-container {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)) !important;
    gap: 0.75rem !important;
    margin-left: 0 !important;
  }
  @media (min-width: 640px) {
    .view-mode-grid .video-group-content:not([style*="display: none"]),
    .view-mode-grid .audio-group-content:not([style*="display: none"]),
    .view-mode-grid .standalone-media-container {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)) !important;
      gap: 1rem !important;
    }
  }
  .view-mode-grid .video-card,
  .view-mode-grid .audio-card {
    flex-direction: column !important;
    align-items: stretch !important;
    margin-left: 0 !important;
    padding: 0.625rem !important;
    height: 100% !important;
  }
  .view-mode-grid .video-card .card-main-row,
  .view-mode-grid .audio-card .card-main-row {
    flex-direction: column !important;
    align-items: stretch !important;
  }
  .view-mode-grid .video-card .card-thumb-wrap {
    width: 100% !important;
    height: 110px !important;
  }
  .view-mode-grid .audio-card .card-thumb-wrap {
    width: 100% !important;
    height: 80px !important;
  }
  .view-mode-grid .video-card .card-info-wrap,
  .view-mode-grid .audio-card .card-info-wrap {
    width: 100% !important;
    margin-top: 0.5rem !important;
  }
  .view-mode-grid .video-card .card-actions-wrap,
  .view-mode-grid .audio-card .card-actions-wrap {
    margin-top: 0.5rem !important;
    justify-content: flex-end !important;
    border-top: 1px solid rgba(75, 85, 99, 0.3) !important;
    padding-top: 0.375rem !important;
    width: 100% !important;
  }

  /* Media selection styling */
  .view-mode-grid .video-card,
  .view-mode-grid .audio-card {
    position: relative !important;
  }
  .view-mode-grid .media-checkbox-wrap {
    position: absolute !important;
    top: 8px !important;
    left: 8px !important;
    z-index: 20 !important;
    background: rgba(15, 23, 42, 0.85) !important;
    backdrop-filter: blur(4px) !important;
    border-radius: 8px !important;
    padding: 3px !important;
    border: 1px solid rgba(255, 255, 255, 0.18) !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35) !important;
    line-height: 0 !important;
  }
  .video-card.is-selected {
    border-color: rgba(168, 85, 247, 0.85) !important;
    background-color: rgba(147, 51, 234, 0.12) !important;
    box-shadow: 0 0 0 1px rgba(168, 85, 247, 0.4) !important;
  }
  .audio-card.is-selected {
    border-color: rgba(34, 197, 94, 0.85) !important;
    background-color: rgba(34, 197, 94, 0.12) !important;
    box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.4) !important;
  }
  @keyframes slideUpBatchBar {
    from {
      opacity: 0;
      transform: translate(-50%, 16px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }
  #batchActionBar:not(.hidden) {
    animation: slideUpBatchBar 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<div class="flex flex-col lg:flex-row lg:items-center justify-between mb-6 gap-4">
  <div>
    <h2 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2">
      <span>Media Gallery</span>
    </h2>
    <p class="text-gray-400 text-xs sm:text-sm mt-1">Manage your videos and audio for streaming</p>
  </div>
  
  <!-- 1 Single Neat Row: Grouped Video & Audio Action Bar -->
  <div class="grid grid-cols-2 gap-2 sm:gap-3 w-full lg:w-auto">
    <!-- Group Video: Upload & Import Drive -->
    <div id="videoGroupContainer" class="flex items-center bg-dark-800/90 border <%= activeTab === 'audio' ? 'border-gray-700/60 hover:border-purple-500/40' : 'border-primary shadow-md shadow-primary/20' %> rounded-xl p-1 gap-1 transition-all duration-200">
      <button onclick="openUploadModal()" id="uploadVideoBtn"
        title="Upload Video"
        class="flex-1 h-9 px-2 sm:px-3.5 rounded-lg text-xs sm:text-sm font-medium text-white bg-gradient-to-r from-primary to-purple-600 hover:from-primary/90 hover:to-purple-500 active:scale-[0.98] transition-all flex items-center justify-center gap-1.5 shadow-sm shadow-primary/25">
        <i class="ti ti-upload text-sm"></i>
        <span class="whitespace-nowrap"><span class="hidden sm:inline">Upload </span>Video</span>
      </button>
      <button onclick="openGDriveModal()" id="gdriveBtn"
        title="Import Video from Google Drive"
        class="flex-1 h-9 px-2 sm:px-3 rounded-lg text-xs sm:text-sm font-medium text-gray-200 hover:text-white bg-dark-700/80 hover:bg-dark-600 border border-gray-600/50 hover:border-[#4285F4]/60 active:scale-[0.98] transition-all flex items-center justify-center gap-1.5">
        <i class="ti ti-brand-google-drive text-[#4285F4] text-sm"></i>
        <span class="whitespace-nowrap">Drive<span class="hidden sm:inline"> Video</span></span>
      </button>
    </div>

    <!-- Group Audio: Upload & Import Drive -->
    <div id="audioGroupContainer" class="flex items-center bg-dark-800/90 border <%= activeTab === 'audio' ? 'border-emerald-500 shadow-md shadow-emerald-500/20' : 'border-gray-700/60 hover:border-emerald-500/40' %> rounded-xl p-1 gap-1 transition-all duration-200">
      <button onclick="openAudioUploadModal()" id="uploadAudioBtn"
        title="Upload Audio"
        class="flex-1 h-9 px-2 sm:px-3.5 rounded-lg text-xs sm:text-sm font-medium text-white bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-500 hover:to-green-500 active:scale-[0.98] transition-all flex items-center justify-center gap-1.5 shadow-sm shadow-emerald-600/25">
        <i class="ti ti-upload text-sm"></i>
        <span class="whitespace-nowrap"><span class="hidden sm:inline">Upload </span>Audio</span>
      </button>
      <button onclick="openAudioGDriveModal()" id="gdriveAudioBtn"
        title="Import Audio from Google Drive"
        class="flex-1 h-9 px-2 sm:px-3 rounded-lg text-xs sm:text-sm font-medium text-gray-200 hover:text-white bg-dark-700/80 hover:bg-dark-600 border border-gray-600/50 hover:border-emerald-500/60 active:scale-[0.98] transition-all flex items-center justify-center gap-1.5">
        <i class="ti ti-brand-google-drive text-emerald-400 text-sm"></i>
        <span class="whitespace-nowrap">Drive<span class="hidden sm:inline"> Audio</span></span>
      </button>
    </div>
  </div>
</div>

<!-- Tab Navigation - Professional style with dividers -->
<div class="flex w-full border border-gray-600 rounded-lg mb-6 overflow-hidden bg-gray-800/50">
  <button onclick="switchTab('video')" id="videoTab"
    class="flex-1 px-4 md:px-6 py-3 font-medium transition-colors text-center <%= activeTab !== 'audio' ? 'bg-primary/20 text-primary border-b-2 border-primary' : 'text-gray-400 hover:text-white hover:bg-gray-700/50' %>">
    <i class="ti ti-video mr-2"></i>Videos (<%= videos ? videos.length : 0 %>)
  </button>
  <div class="w-px bg-gray-600"></div>
  <button onclick="switchTab('audio')" id="audioTab"
    class="flex-1 px-4 md:px-6 py-3 font-medium transition-colors text-center <%= activeTab === 'audio' ? 'bg-green-500/20 text-green-500 border-b-2 border-green-500' : 'text-gray-400 hover:text-white hover:bg-gray-700/50' %>">
    <i class="ti ti-music mr-2"></i>Audio (<%= audios ? audios.length : 0 %>)
  </button>
</div>

<!-- Search and Action Toolbar (Responsive Modern Toolbar) -->
<div class="bg-gray-800/80 backdrop-blur-sm border border-gray-700/60 rounded-2xl p-2.5 sm:p-3.5 mb-6 shadow-sm">
  <div class="mb-2 flex items-center gap-1.5 text-[11px] sm:text-xs text-gray-400/90 px-0.5">
    <i class="ti ti-info-circle text-primary shrink-0"></i>
    <span class="truncate">Gunakan tombol folder di kartu media untuk memindahkan file, atau buat folder baru dari toolbar.</span>
  </div>
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 sm:gap-2.5 w-full">
    <!-- Search Input (full width on mobile, flexible on desktop) -->
    <div class="relative flex-1 min-w-0">
      <input type="text" id="searchInput" placeholder="Search media..."
        class="w-full h-9 sm:h-10 bg-dark-700/90 text-white pl-9 pr-3 text-xs sm:text-sm border border-gray-600/50 rounded-xl focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary placeholder-gray-400 transition-all">
      <i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm sm:text-base"></i>
    </div>

    <!-- Actions Toolbar: Neatly aligned row on both mobile and desktop -->
    <div class="flex items-center justify-between sm:justify-end gap-1.5 sm:gap-2 shrink-0">
      <div class="flex items-center gap-1.5 sm:gap-2">

        <!-- 1. Create Folder Button (Contextual for Active Tab: Video or Audio) -->
        <button type="button" onclick="createMediaFolder()" id="createFolderBtn" title="Buat Folder Baru"
          class="h-9 sm:h-10 px-2.5 sm:px-3 flex items-center justify-center gap-1.5 bg-dark-700/90 hover:bg-dark-600 border border-gray-600/50 hover:border-primary text-primary hover:text-white rounded-xl transition-all active:scale-95 shadow-sm shrink-0 text-xs font-medium">
          <i class="ti ti-folder-plus text-sm sm:text-base"></i>
          <span class="hidden sm:inline">Folder Baru</span>
        </button>

        <!-- 2. Delete Selected Folders Button -->
        <% if (typeof permissions !== 'undefined' && permissions.can_delete_videos) { %>
        <button type="button" onclick="deleteSelectedFolders()" title="Hapus Folder Terpilih"
          class="h-9 sm:h-10 w-9 sm:w-10 flex items-center justify-center bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 hover:border-red-500/50 text-red-400 hover:text-red-300 rounded-xl transition-all active:scale-95 shadow-sm shrink-0">
          <i class="ti ti-trash text-sm sm:text-base"></i>
        </button>
        <% } %>
      </div>

      <!-- 3. Grid / List View Mode Toggle -->
      <div class="flex items-center h-9 sm:h-10 bg-dark-700/90 border border-gray-600/50 rounded-xl p-0.5 shrink-0 ml-1 sm:ml-0">
        <button type="button" onclick="setGalleryViewMode('grid')" id="viewGridBtn" title="Grid View"
          class="w-8 sm:w-9 h-full flex items-center justify-center rounded-lg text-gray-400 hover:text-white transition-all">
          <i class="ti ti-layout-grid text-sm sm:text-base"></i>
        </button>
        <div class="w-px h-3.5 sm:h-4 bg-gray-600/50"></div>
        <button type="button" onclick="setGalleryViewMode('list')" id="viewListBtn" title="List View"
          class="w-8 sm:w-9 h-full flex items-center justify-center rounded-lg text-gray-400 hover:text-white transition-all">
          <i class="ti ti-list text-sm sm:text-base"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Video List -->
<div id="videoGrid" class="flex flex-col gap-3 <%= activeTab === 'audio' ? 'tab-hidden' : 'tab-visible' %>">
  <% if (typeof viewPermissionDenied !== 'undefined' && viewPermissionDenied) { %>
    <div class="text-center py-12 bg-gray-800 rounded-lg">
      <div class="text-red-400 mb-3"><i class="ti ti-lock text-5xl"></i></div>
      <h3 class="text-lg font-medium text-gray-300 mb-1">Permission Denied</h3>
      <p class="text-gray-500 text-sm">You do not have permission to view videos. Please contact your administrator.</p>
    </div>
  <% } else if (videos && videos.length > 0) { %>
    <% 
    // Separate explicit user folders from standalone videos
    const videoFoldersByName = {};
    const standaloneVideos = [];
    
    videos.forEach(function(video) {
      const explicitFolder = (video.folder_name || '').trim();
      if (explicitFolder) {
        const baseKey = explicitFolder.toLowerCase();
        if (!videoFoldersByName[baseKey]) {
          videoFoldersByName[baseKey] = {
            displayName: explicitFolder,
            videos: []
          };
        }
        videoFoldersByName[baseKey].videos.push(video);
      } else {
        standaloneVideos.push(video);
      }
    });
    
    // Sort folder groups by most recent video
    const videoFolderKeys = Object.keys(videoFoldersByName).sort((a, b) => {
      const latestA = Math.max(...videoFoldersByName[a].videos.map(v => new Date(v.upload_date)));
      const latestB = Math.max(...videoFoldersByName[b].videos.map(v => new Date(v.upload_date)));
      return latestB - latestA;
    });
    %>

    <!-- Real Folders (only shown if user created/moved into folders) -->
    <% videoFolderKeys.forEach(function(groupKey, groupIndex) { 
      const group = videoFoldersByName[groupKey];
      const groupVideos = group.videos.sort((a, b) => new Date(b.upload_date) - new Date(a.upload_date));
    %>
      <div class="video-group" data-name="<%= groupKey %>" data-video-ids='<%- JSON.stringify(groupVideos.map(v => v.id)) %>'>
        <!-- Folder Header -->
        <div class="media-drop-target bg-dark-750/90 hover:bg-dark-700/90 rounded-xl p-2.5 sm:p-3 flex items-center justify-between cursor-pointer transition-all border border-gray-700/60 shadow-sm" onclick="toggleVideoGroup('<%= groupIndex %>')" data-media-type="video" data-folder-name="<%= group.displayName %>">
          <div class="flex items-center gap-2.5 min-w-0">
            <i class="ti ti-chevron-down text-gray-400 text-sm transition-transform duration-200 shrink-0" id="videoGroupIcon<%= groupIndex %>"></i>
            <div class="w-7 h-7 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0">
              <i class="ti ti-folder text-base"></i>
            </div>
            <div class="min-w-0">
              <h3 class="font-medium text-xs sm:text-sm text-white truncate"><%= group.displayName %></h3>
              <p class="text-[11px] text-gray-400"><%= groupVideos.length %> video<%= groupVideos.length > 1 ? 's' : '' %></p>
            </div>
          </div>
          <div class="flex items-center gap-1 shrink-0">
            <button type="button" onclick="renameMediaFolder(event, 'video')" title="Rename Folder" class="p-1.5 text-gray-400 hover:text-primary hover:bg-primary/10 rounded-lg transition-colors">
              <i class="ti ti-pencil text-sm"></i>
            </button>
            <% if (typeof permissions !== 'undefined' && permissions.can_delete_videos) { %>
            <button type="button" onclick="deleteSingleFolder(event, 'video')" title="Hapus Folder" class="p-1.5 text-gray-400 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-colors">
              <i class="ti ti-trash text-sm"></i>
            </button>
            <label class="flex items-center gap-1.5 text-xs text-gray-300 cursor-pointer pl-1" onclick="event.stopPropagation()">
              <input type="checkbox" class="video-folder-checkbox rounded border-gray-500 bg-dark-700 text-red-500 focus:ring-red-500"
                data-folder-name="<%= group.displayName %>" data-ids='<%- JSON.stringify(groupVideos.map(v => v.id)) %>'>
              <span class="text-[11px] hidden sm:inline">Select</span>
            </label>
            <% } %>
          </div>
        </div>
        
        <!-- Folder Content -->
        <div class="video-group-content mt-1.5 space-y-1.5 pl-2 sm:pl-3 border-l-2 border-primary/20 ml-2" id="videoGroupContent<%= groupIndex %>">
          <% groupVideos.forEach(function(video) { %>
            <div class="video-card bg-gray-800/90 hover:bg-gray-750 border border-gray-700/60 rounded-xl p-2 sm:p-2.5 flex items-center justify-between gap-2.5 transition-all shadow-sm"
              data-title="<%= video.title.toLowerCase() %>"
              data-raw-title="<%= video.title %>"
              data-date="<%= video.upload_date %>"
              data-id="<%= video.id %>"
              data-current-folder="<%= group.displayName %>"
              data-media-type="video"
              data-duration="<%= formatDuration(video.duration) %>"
              data-size="<%= formatFileSize(video.file_size) %>"
              data-resolution="<%= video.resolution || '' %>"
              data-thumb="<%= video.thumbnail_path %>"
              data-date-str="<%= new Date(video.upload_date).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %>">
              <div class="flex items-center gap-2.5 min-w-0 flex-1 card-main-row">
                <div class="shrink-0 flex items-center media-checkbox-wrap" onclick="event.stopPropagation()">
                  <input type="checkbox" class="media-select-checkbox video-select-checkbox w-4 h-4 rounded border-gray-600 bg-dark-700 text-primary focus:ring-primary cursor-pointer transition-all"
                    data-id="<%= video.id %>"
                    data-title="<%= video.title %>"
                    data-type="video"
                    data-folder="<%= group.displayName %>"
                    data-is-standalone="false"
                    onchange="onMediaCheckChange('video')">
                </div>
                <div class="relative w-12 h-9 sm:w-14 sm:h-10 md:w-16 md:h-11 flex-shrink-0 rounded-lg overflow-hidden bg-black cursor-pointer group card-thumb-wrap" onclick="playVideo('<%= video.id %>', '<%= video.title.replace(/'/g, "\\'") %>')">
                  <img src="<%= video.thumbnail_path %>" alt="<%= video.title %>" class="w-full h-full object-cover">
                  <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                    <i class="ti ti-player-play-filled text-white text-xs sm:text-sm"></i>
                  </div>
                  <span class="absolute bottom-0.5 right-0.5 bg-black/85 text-white text-[9px] px-1 rounded font-mono leading-tight">
                    <%= formatDuration(video.duration) %>
                  </span>
                </div>
                <div class="min-w-0 flex-1 card-info-wrap">
                  <h4 class="font-medium text-xs sm:text-sm text-white truncate leading-tight" title="<%= video.title %>"><%= video.title %></h4>
                  <div class="text-[11px] text-gray-400 truncate flex items-center gap-1.5 mt-0.5 whitespace-nowrap">
                    <span><%= formatDuration(video.duration) %></span>
                    <span class="text-gray-600">•</span>
                    <span><%= formatFileSize(video.file_size) %></span>
                    <% if (video.resolution) { %>
                    <span class="text-gray-600 hidden sm:inline">•</span>
                    <span class="hidden sm:inline"><%= video.resolution %></span>
                    <% } %>
                    <span class="text-gray-600 hidden md:inline">•</span>
                    <span class="hidden md:inline"><%= new Date(video.upload_date).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %></span>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-0.5 sm:gap-1 flex-shrink-0 card-actions-wrap">
                <button type="button" class="w-8 h-8 flex items-center justify-center text-gray-400 hover:text-white hover:bg-gray-700/60 rounded-lg transition-colors" onclick="playVideo('<%= video.id %>', '<%= video.title.replace(/'/g, "\\'") %>')" title="Play">
                  <i class="ti ti-player-play text-base"></i>
                </button>
                <button type="button" class="w-8 h-8 flex items-center justify-center text-gray-400 hover:text-cyan-400 hover:bg-cyan-500/10 rounded-lg transition-colors" onclick="openMoveMediaModal('<%= video.id %>', '<%= video.title.replace(/'/g, "\\'") %>', 'video', '<%= (video.folder_name || '').replace(/'/g, "\\'") %>')" title="Pindah ke Folder">
                  <i class="ti ti-folder-share text-base"></i>
                </button>
                <% if (typeof permissions !== 'undefined' && permissions.can_download_videos) { %>
                <button type="button" class="w-8 h-8 items-center justify-center text-gray-400 hover:text-blue-400 hover:bg-blue-500/10 rounded-lg transition-colors hidden sm:flex" onclick="downloadVideo('<%= video.id %>', '<%= video.title.replace(/'/g, "\\'") %>')" title="Download">
                  <i class="ti ti-download text-base"></i>
                </button>
                <% } %>
                <button type="button" class="w-8 h-8 items-center justify-center text-gray-400 hover:text-primary hover:bg-primary/10 rounded-lg transition-colors hidden sm:flex" onclick="showRenameDialog('<%= video.id %>', '<%= video.title.replace(/'/g, "\\'") %>')" title="Rename">
                  <i class="ti ti-pencil text-base"></i>
                </button>
                <% if (typeof permissions !== 'undefined' && permissions.can_delete_videos) { %>
                <button type="button" class="w-8 h-8 items-center justify-center text-gray-400 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-colors hidden sm:flex" onclick="showDeleteDialog('<%= video.id %>', '<%= video.title.replace(/'/g, "\\'") %>')" title="Delete">
                  <i class="ti ti-trash text-base"></i>
                </button>
                <% } %>
                <div class="relative sm:hidden card-menu-container">
