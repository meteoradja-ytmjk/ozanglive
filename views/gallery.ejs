              <h3 class="font-medium text-xs sm:text-sm text-white truncate"><%= group.displayName %></h3>
              <p class="text-[11px] text-gray-400"><%= groupAudios.length %> audio<%= groupAudios.length > 1 ? 's' : '' %></p>
            </div>
          </div>
          <div class="flex items-center gap-1 shrink-0">
            <button type="button" onclick="renameMediaFolder(event, 'audio')" title="Rename Folder" class="p-1.5 text-gray-400 hover:text-emerald-400 hover:bg-emerald-500/10 rounded-lg transition-colors">
              <i class="ti ti-pencil text-sm"></i>
            </button>
            <% if (typeof permissions !== 'undefined' && permissions.can_delete_videos) { %>
