  function getSelectedFolderPayload() {
    if (currentTab === 'audio') {
      const checkboxes = Array.from(document.querySelectorAll('.audio-folder-checkbox:checked'));
      const audioIds = [...new Set(checkboxes.flatMap((checkbox) => {
        try {
          const ids = JSON.parse(checkbox.dataset.ids || '[]');
          return Array.isArray(ids) ? ids : [];
        } catch {
          return [];
        }
      }))];
      const folderCount = checkboxes.length;
      return { type: 'audio', ids: audioIds, folderCount };
    }

    const checkboxes = Array.from(document.querySelectorAll('.video-folder-checkbox:checked'));
    const videoIds = [...new Set(checkboxes.flatMap((checkbox) => {
      try {
        const ids = JSON.parse(checkbox.dataset.ids || '[]');
        return Array.isArray(ids) ? ids : [];
      } catch {
        return [];
      }
    }))];
    const folderCount = checkboxes.length;
    return { type: 'video', ids: videoIds, folderCount };
  }

  function deleteSelectedFolders() {
    const payload = getSelectedFolderPayload();
    if (payload.folderCount === 0) {
      showToast('error', currentTab === 'audio' ? 'Pilih folder audio dulu' : 'Pilih folder video dulu');
      return;
    }

    if (payload.ids.length === 0) {
      showToast('error', 'Folder terpilih tidak punya item yang bisa dihapus');
      return;
    }

    const itemLabel = payload.type === 'audio' ? 'audio' : 'video';
    const ok = confirm(`Delete ${payload.folderCount} selected folder(s) with ${payload.ids.length} ${itemLabel}?`);
    if (!ok) return;

    const endpoint = payload.type === 'audio' ? '/api/audios/delete-folder' : '/api/videos/delete-folder';
    const body = payload.type === 'audio' ? { audioIds: payload.ids } : { videoIds: payload.ids };

    fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': '<%= csrfToken %>'
      },
      body: JSON.stringify(body)
    }).then(r => r.json()).then(data => {
      if (data.success) {
        showToast('success', data.message || 'Selected folders deleted');
        setTimeout(() => location.reload(), 1000);
      } else {
        showToast('error', data.error || 'Failed to delete selected folders');
      }
    }).catch(() => showToast('error', 'Failed to delete selected folders'));
  }
  
