  // Create folder contextual to currently active tab (Video vs Audio)
  function createMediaFolder() {
    const isAudio = currentTab === 'audio';
    const type = isAudio ? 'audio' : 'video';
    const mediaLabel = isAudio ? 'Audio' : 'Video';

    const inputName = prompt(`Nama folder baru untuk ${mediaLabel}:`);
    if (inputName === null) return;

    const folderName = inputName.replace(/[\r\n\t]+/g, ' ').replace(/\s+/g, ' ').trim();
    if (!folderName) {
      showToast('error', 'Nama folder tidak boleh kosong');
      return;
    }
    if (folderName.length > 120) {
      showToast('error', 'Nama folder maksimal 120 karakter');
      return;
    }

    const grid = document.getElementById(isAudio ? 'audioGrid' : 'videoGrid');
    if (grid) {
      const existing = Array.from(grid.querySelectorAll('.media-drop-target')).some(
        t => (t.dataset.folderName || '').toLowerCase() === folderName.toLowerCase()
      );
      if (existing) {
        showToast('error', `Folder "${folderName}" sudah ada di tab ${mediaLabel}`);
        return;
      }
    }

    addEmptyFolderStorage(type, folderName);
    renderEmptyFolderDOM(type, folderName);
    showToast('success', `Folder "${folderName}" berhasil dibuat di ${mediaLabel}`);
  }

  function initEmptyMediaFolders() {
    ['video', 'audio'].forEach(type => {
      const isAudio = type === 'audio';
      const grid = document.getElementById(isAudio ? 'audioGrid' : 'videoGrid');
      if (!grid) return;

      const storedList = getEmptyFoldersStorage(type);
      const cleanedList = [];

      storedList.forEach(folderName => {
        const existingPopulated = Array.from(grid.querySelectorAll(`.${isAudio ? 'audio-group' : 'video-group'}:not(.empty-media-folder)`)).some(
          g => (g.querySelector('.media-drop-target')?.dataset.folderName || '').toLowerCase() === folderName.toLowerCase()
        );
        if (!existingPopulated) {
          cleanedList.push(folderName);
          renderEmptyFolderDOM(type, folderName);
        }
      });

      localStorage.setItem(isAudio ? 'emptyAudioFolders' : 'emptyVideoFolders', JSON.stringify(cleanedList));
    });
  }

