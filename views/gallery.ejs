  // Close all open 3-dots card action menus and restore z-indexes
  function closeAllCardMenus() {
    document.querySelectorAll('.card-action-menu').forEach(m => {
      m.classList.add('hidden');
    });
    document.querySelectorAll('.video-card, .audio-card').forEach(card => {
      card.style.zIndex = '';
    });
    document.querySelectorAll('.card-menu-container').forEach(c => {
      c.style.zIndex = '';
    });
  }

  // Toggle 3-dots action menu on mobile cards with smart flip & z-index elevation
  function toggleCardActionMenu(event, menuId) {
    event.stopPropagation();
    const menu = document.getElementById(menuId);
    if (!menu) return;

    const isCurrentlyOpen = !menu.classList.contains('hidden');
    
    // Close any currently open menus first
    closeAllCardMenus();

    if (!isCurrentlyOpen) {
      const triggerBtn = event.currentTarget;
      const btnRect = triggerBtn.getBoundingClientRect();
      const card = triggerBtn.closest('.video-card, .audio-card');
      const menuContainer = triggerBtn.closest('.card-menu-container') || triggerBtn.parentElement;

      // Smart flip: measure space in viewport to prevent clipping at the bottom
      const estimatedMenuHeight = 185;
      const spaceBelow = window.innerHeight - btnRect.bottom;
      const spaceAbove = btnRect.top;

      menu.classList.remove('bottom-full', 'mb-1', 'top-full', 'mt-1');
      if (spaceBelow < estimatedMenuHeight && spaceAbove > spaceBelow) {
        // Open upwards
        menu.classList.add('bottom-full', 'mb-1');
      } else {
        // Open downwards
        menu.classList.add('top-full', 'mt-1');
      }

      // Elevate z-index so the menu always floats above subsequent cards and headers
      if (card) {
        card.style.zIndex = '45';
        card.style.position = 'relative';
      }
      if (menuContainer) {
        menuContainer.style.zIndex = '50';
      }

      menu.classList.remove('hidden');
    }
  }

  // Close menus on outside click or window resize
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.card-action-menu') && !e.target.closest('button[onclick*="toggleCardActionMenu"]')) {
      closeAllCardMenus();
    }
  });

  window.addEventListener('resize', closeAllCardMenus);

  // Media Information Detail Modal logic
  let activeMediaInfo = null;

  function openMediaInfoModal(id, type) {
    closeAllCardMenus();
    const isAudio = type === 'audio';
    const card = document.querySelector(`.${isAudio ? 'audio' : 'video'}-card[data-id="${id}"]`);
    if (!card) return;

    const title = card.getAttribute('data-raw-title') || card.querySelector('h4')?.textContent?.trim() || '';
    const folder = card.getAttribute('data-current-folder') || '';
    const duration = card.getAttribute('data-duration') || '-';
    const size = card.getAttribute('data-size') || '-';
    const resOrFormat = isAudio 
      ? (card.getAttribute('data-format') || 'AUDIO') 
      : (card.getAttribute('data-resolution') || 'Standard');
    const dateStr = card.getAttribute('data-date-str') || '-';
    const thumb = card.getAttribute('data-thumb') || '';

    activeMediaInfo = { id, type, title, folder, duration, size, resOrFormat, dateStr, thumb };

    const modal = document.getElementById('mediaInfoModal');
    if (!modal) return;

    const titleEl = document.getElementById('infoModalTitle');
    const folderEl = document.getElementById('infoModalFolder');
    const durEl = document.getElementById('infoModalDuration');
    const sizeEl = document.getElementById('infoModalSize');
    const formatLabelEl = document.getElementById('infoModalFormatLabel');
    const formatEl = document.getElementById('infoModalFormat');
    const dateEl = document.getElementById('infoModalDate');
    const badge = document.getElementById('infoModalTypeBadge');
    const previewWrap = document.getElementById('infoModalPreviewWrap');
    const headerIconWrap = document.getElementById('infoModalHeaderIconWrap');
    const dlBtn = document.getElementById('infoModalDownloadBtn');

    if (titleEl) titleEl.textContent = title;
    if (folderEl) folderEl.textContent = folder ? folder : '(Tanpa Folder / Root)';
    if (durEl) durEl.textContent = duration;
    if (sizeEl) sizeEl.textContent = size;
    if (formatLabelEl) formatLabelEl.innerHTML = `<i class="ti ti-aspect-ratio text-gray-500"></i> ${isAudio ? 'Format Audio' : 'Resolusi Video'}`;
    if (formatEl) formatEl.textContent = resOrFormat;
    if (dateEl) dateEl.textContent = dateStr;

    if (badge) {
      badge.textContent = isAudio ? 'Audio' : 'Video';
      badge.className = isAudio 
        ? 'px-2 py-0.5 text-[11px] font-semibold rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 shrink-0'
        : 'px-2 py-0.5 text-[11px] font-semibold rounded-full bg-primary/20 text-primary border border-primary/30 shrink-0';
    }

    if (headerIconWrap) {
      headerIconWrap.className = isAudio
        ? 'w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0'
        : 'w-9 h-9 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary shrink-0';
      headerIconWrap.innerHTML = isAudio ? '<i class="ti ti-music text-lg"></i>' : '<i class="ti ti-video text-lg"></i>';
    }

    if (previewWrap) {
      if (isAudio) {
        previewWrap.innerHTML = `
          <div class="w-14 h-14 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center shrink-0 shadow-sm">
            <i class="ti ti-music text-2xl text-emerald-400"></i>
          </div>
        `;
      } else {
        previewWrap.innerHTML = `
          <div class="relative w-20 h-14 rounded-xl overflow-hidden bg-black border border-gray-700/80 shrink-0 shadow-sm">
            <img src="${thumb}" alt="${title.replace(/"/g, '&quot;')}" class="w-full h-full object-cover">
            <span class="absolute bottom-0.5 right-0.5 bg-black/85 text-white text-[9px] px-1 rounded font-mono">${duration}</span>
          </div>
        `;
      }
    }

    if (dlBtn) {
      dlBtn.style.display = (!isAudio && typeof permissions !== 'undefined' && permissions.can_download_videos) ? 'flex' : 'none';
    }

    modal.classList.remove('hidden');
  }

  function closeMediaInfoModal() {
