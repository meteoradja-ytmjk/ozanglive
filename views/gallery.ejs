  function updateMinimizedVideoStatus() {
    const statusEl = document.getElementById('minimizedVideoStatus');
    const progressBarContainer = document.getElementById('minimizedVideoProgressBar');
    const progressBar = progressBarContainer?.querySelector('div');
    const modal = document.getElementById('uploadModal');
    const minimized = document.getElementById('minimizedVideoModal');
    
    if (!window.videoQueueManager) return;
    
    const files = videoQueueManager.getFiles();
    const uploading = files.filter(f => f.status === 'uploading').length;
    const completed = files.filter(f => f.status === 'success').length;
    const failed = files.filter(f => f.status === 'error').length;
    const total = files.length;
    const pending = files.filter(f => f.status === 'pending').length;
    
    if (modal?.classList.contains('hidden') && minimized && (uploading > 0 || pending > 0)) {
      minimized.classList.remove('hidden');
    }
    
    if (uploading > 0) {
      statusEl.textContent = `Uploading ${uploading} of ${total} files...`;
      progressBarContainer.classList.remove('hidden');
      const progress = total > 0 ? Math.round((completed / total) * 100) : 0;
      if (progressBar) progressBar.style.width = `${progress}%`;
    } else if (completed > 0 || failed > 0) {
      statusEl.textContent = `${completed} success, ${failed} failed`;
      progressBarContainer.classList.add('hidden');
    } else {
      statusEl.textContent = `${total} file(s) ready`;
      progressBarContainer.classList.add('hidden');
    }
  }
  
