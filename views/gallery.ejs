<script src="/js/fileQueueManager.js"></script>
<script src="/js/driveImportQueueManager.js"></script>
<script>
  let currentTab = '<%= activeTab || "video" %>';
  let activeMoveItem = null; // { id, title, type, currentFolder, isBatch, ids }
  let selectedMoveFolder = '';

  // Selection state tracking
  const selectedMediaIds = {
    video: new Set(),
    audio: new Set()
  };

  function getActiveTabType() {
    return currentTab === 'audio' ? 'audio' : 'video';
  }

  function onMediaCheckChange(type) {
    const t = type || getActiveTabType();
    const checkboxes = document.querySelectorAll(`.${t}-select-checkbox`);
    const set = selectedMediaIds[t];
    set.clear();

    checkboxes.forEach(cb => {
      const card = cb.closest(`.${t}-card`);
      if (cb.checked) {
        set.add(cb.dataset.id);
        if (card) card.classList.add('is-selected');
      } else {
        if (card) card.classList.remove('is-selected');
      }
    });

    updateBatchActionBar();
    updateMarkAllToolbarBtn();
  }

  function updateBatchActionBar() {
    const t = getActiveTabType();
    const count = selectedMediaIds[t].size;
    const bar = document.getElementById('batchActionBar');
    const countEl = document.getElementById('batchBarCount');
    const badgeIcon = document.getElementById('batchBarBadgeIcon');
    const moveBtn = document.getElementById('batchMoveBtn');

    if (!bar) return;

    if (count > 0) {
      bar.classList.remove('hidden');
      if (countEl) countEl.textContent = `${count} dipilih`;
      if (badgeIcon) {
        badgeIcon.className = t === 'audio'
          ? 'w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0'
          : 'w-7 h-7 rounded-lg bg-primary/20 text-primary flex items-center justify-center shrink-0';
      }
      if (moveBtn) {
        moveBtn.className = t === 'audio'
          ? 'h-8 sm:h-9 px-3 sm:px-4 text-xs sm:text-sm font-semibold text-white bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-500 hover:to-green-500 active:scale-95 transition-all shadow-md shadow-emerald-600/30 rounded-xl flex items-center justify-center gap-1.5 shrink-0'
          : 'h-8 sm:h-9 px-3 sm:px-4 text-xs sm:text-sm font-semibold text-white bg-gradient-to-r from-primary to-purple-600 hover:from-primary/90 hover:to-purple-500 active:scale-95 transition-all shadow-md shadow-primary/30 rounded-xl flex items-center justify-center gap-1.5 shrink-0';
      }
    } else {
      bar.classList.add('hidden');
    }
  }

  function updateMarkAllToolbarBtn() {
    ['video', 'audio'].forEach(t => {
      const textEl = document.getElementById(t === 'audio' ? 'markAllUploadedAudioText' : 'markAllUploadedVideoText');
      const iconEl = document.getElementById(t === 'audio' ? 'markAllUploadedAudioIcon' : 'markAllUploadedVideoIcon');
      const container = document.querySelector(`#${t}Grid .standalone-media-container`);
      if (!container) return;

      const standaloneCheckboxes = Array.from(container.querySelectorAll(`.${t}-select-checkbox`)).filter(cb => {
        const card = cb.closest(`.${t}-card`);
        return !card || card.style.display !== 'none';
      });

      if (standaloneCheckboxes.length === 0) return;

      const checkedCount = standaloneCheckboxes.filter(cb => cb.checked).length;
      const allChecked = checkedCount === standaloneCheckboxes.length;

      if (textEl) {
        textEl.textContent = allChecked ? 'Batal Pilih' : 'Mark All';
      }
      if (iconEl) {
        iconEl.className = allChecked ? 'ti ti-square-x text-sm' : 'ti ti-checkbox text-sm';
      }
    });
  }

  function getVisibleMediaCheckboxes(type) {
    const t = type || getActiveTabType();
    const all = Array.from(document.querySelectorAll(`.${t}-select-checkbox`));
    return all.filter(cb => {
      const card = cb.closest(`.${t}-card`);
      if (!card) return false;
      return card.style.display !== 'none' && card.offsetParent !== null;
    });
  }

  function toggleMarkAllCurrentTab() {
    const t = getActiveTabType();
    const visibleCheckboxes = getVisibleMediaCheckboxes(t);
    if (visibleCheckboxes.length === 0) {
      showToast('error', `Tidak ada ${t} untuk dipilih`);
      return;
    }

    const checkedCount = visibleCheckboxes.filter(cb => cb.checked).length;
    const shouldCheck = checkedCount < visibleCheckboxes.length;

    visibleCheckboxes.forEach(cb => {
      cb.checked = shouldCheck;
      const card = cb.closest(`.${t}-card`);
      if (card) {
        if (shouldCheck) card.classList.add('is-selected');
        else card.classList.remove('is-selected');
      }
      if (shouldCheck) {
        selectedMediaIds[t].add(cb.dataset.id);
      } else {
        selectedMediaIds[t].delete(cb.dataset.id);
      }
    });

    updateBatchActionBar();
    updateMarkAllToolbarBtn();
    showToast('success', shouldCheck ? `Menandai ${visibleCheckboxes.length} ${t}` : 'Semua pilihan dibatalkan');
  }

  function markAllUploadedMedia(type) {
    const t = type || getActiveTabType();
    const container = document.querySelector(`#${t}Grid .standalone-media-container`);
    if (!container) {
      showToast('error', `Tidak ada file upload tanpa folder`);
      return;
    }
    const standaloneCheckboxes = Array.from(container.querySelectorAll(`.${t}-select-checkbox`)).filter(cb => {
      const card = cb.closest(`.${t}-card`);
      return !card || card.style.display !== 'none';
    });

    if (standaloneCheckboxes.length === 0) {
      showToast('error', `Tidak ada file upload tanpa folder`);
      return;
    }

    const checkedCount = standaloneCheckboxes.filter(cb => cb.checked).length;
    const shouldCheck = checkedCount < standaloneCheckboxes.length;

    standaloneCheckboxes.forEach(cb => {
      cb.checked = shouldCheck;
      const card = cb.closest(`.${t}-card`);
      if (card) {
        if (shouldCheck) card.classList.add('is-selected');
        else card.classList.remove('is-selected');
      }
      if (shouldCheck) {
        selectedMediaIds[t].add(cb.dataset.id);
      } else {
        selectedMediaIds[t].delete(cb.dataset.id);
      }
    });

    updateBatchActionBar();
    updateMarkAllToolbarBtn();
    showToast('success', shouldCheck ? `Menandai ${standaloneCheckboxes.length} file upload ${t}` : 'Batal menandai file upload');
  }

  function clearAllSelections() {
    ['video', 'audio'].forEach(t => {
      selectedMediaIds[t].clear();
      document.querySelectorAll(`.${t}-select-checkbox`).forEach(cb => {
        cb.checked = false;
        const card = cb.closest(`.${t}-card`);
        if (card) card.classList.remove('is-selected');
      });
    });
    updateBatchActionBar();
    updateMarkAllToolbarBtn();
  }

  function openBatchMoveModal() {
    const t = getActiveTabType();
    const ids = Array.from(selectedMediaIds[t]);
    if (ids.length === 0) {
      showToast('error', `Pilih minimal 1 file untuk dipindahkan`);
      return;
    }

    const checkboxes = Array.from(document.querySelectorAll(`.${t}-select-checkbox:checked`));
    const folders = new Set(checkboxes.map(cb => (cb.dataset.folder || '').trim()).filter(Boolean));
    const currentFolderDisplay = folders.size === 1 ? Array.from(folders)[0] : (folders.size === 0 ? '(Tanpa Folder)' : '(Berbagai Folder)');

    openMoveMediaModal(null, `${ids.length} ${t} terpilih`, t, currentFolderDisplay, true, ids);
  }

  async function deleteBatchSelectedMedia() {
    const t = getActiveTabType();
    const ids = Array.from(selectedMediaIds[t]);
    if (ids.length === 0) return;

    const ok = confirm(`Hapus ${ids.length} ${t} terpilih secara permanen?`);
    if (!ok) return;

    const endpoint = t === 'audio' ? '/api/audios/delete-folder' : '/api/videos/delete-folder';
    const body = t === 'audio' ? { audioIds: ids } : { videoIds: ids };

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: JSON.stringify(body)
      });
      const data = await response.json();
      if (data.success) {
        showToast('success', `${ids.length} ${t} berhasil dihapus`);
        clearAllSelections();
        setTimeout(() => location.reload(), 800);
      } else {
        showToast('error', data.error || 'Gagal menghapus file');
      }
    } catch (err) {
      showToast('error', 'Terjadi kesalahan saat menghapus file');
    }
  }

  function openMoveMediaModal(id, title, type, currentFolder, isBatch = false, ids = null) {
    const idsList = isBatch && Array.isArray(ids) ? ids : (id ? [id] : []);
    activeMoveItem = {
      id: id || (idsList[0] || null),
      ids: idsList,
      isBatch: isBatch || idsList.length > 1,
      title: title || `${idsList.length} file`,
      type: type || currentTab,
      currentFolder: currentFolder || ''
    };
    selectedMoveFolder = '';

    const modal = document.getElementById('moveMediaModal');
    const modalHeaderTitle = document.getElementById('moveMediaModalHeaderTitle');
    const modalHeaderSubtitle = document.getElementById('moveMediaModalHeaderSubtitle');
    const titleEl = document.getElementById('moveMediaTitle');
    const folderEl = document.getElementById('moveMediaCurrentFolder');
    const iconEl = document.getElementById('moveMediaIcon');
    const headerIconWrap = document.getElementById('moveMediaHeaderIconWrap');
    const customInput = document.getElementById('customMoveFolderName');
    const previewEl = document.getElementById('moveRenamePreview');
    const confirmBtn = document.getElementById('confirmMoveBtn');

    const isAudio = activeMoveItem.type === 'audio';

    if (modalHeaderTitle) {
      modalHeaderTitle.textContent = activeMoveItem.isBatch
        ? `Pindah ${activeMoveItem.ids.length} File ke Folder`
        : 'Pindah File ke Folder';
    }
    if (modalHeaderSubtitle) {
      modalHeaderSubtitle.textContent = activeMoveItem.isBatch
        ? `Pilih folder tujuan untuk ${activeMoveItem.ids.length} file terpilih`
        : 'Pilih folder tujuan untuk media ini';
    }
    if (titleEl) {
      titleEl.textContent = activeMoveItem.isBatch
        ? `${activeMoveItem.ids.length} file ${isAudio ? 'audio' : 'video'} terpilih`
        : activeMoveItem.title;
    }
    if (folderEl) {
      folderEl.textContent = activeMoveItem.isBatch
        ? (currentFolder || 'Tanpa Folder / Berbagai Folder')
        : (currentFolder || '(Tanpa Folder)');
    }
    if (customInput) customInput.value = '';
    if (previewEl) previewEl.textContent = 'Pilih folder tujuan di atas';

    if (iconEl) iconEl.className = isAudio ? 'ti ti-music text-green-400 text-xl' : 'ti ti-video text-primary text-xl';
    if (headerIconWrap) {
      headerIconWrap.className = isAudio
        ? 'w-9 h-9 rounded-xl bg-green-500/10 flex items-center justify-center text-green-400 shrink-0'
        : 'w-9 h-9 rounded-xl bg-primary/10 flex items-center justify-center text-primary shrink-0';
    }
    if (confirmBtn) {
      confirmBtn.className = isAudio
        ? 'px-5 py-2 rounded-xl text-xs sm:text-sm font-medium text-white bg-green-600 hover:bg-green-500 active:scale-95 transition-all shadow-sm shadow-green-600/30 flex items-center gap-1.5'
        : 'px-5 py-2 rounded-xl text-xs sm:text-sm font-medium text-white bg-primary hover:bg-primary/90 active:scale-95 transition-all shadow-sm shadow-primary/30 flex items-center gap-1.5';
      confirmBtn.disabled = false;
      confirmBtn.innerHTML = `<i class="ti ti-folder-check"></i><span>${activeMoveItem.isBatch ? `Pindahkan ${activeMoveItem.ids.length} File` : 'Pindahkan File'}</span>`;
    }

    // Collect all available folders for this type
    const grid = document.getElementById(isAudio ? 'audioGrid' : 'videoGrid');
    const folderMap = new Map();

    if (grid) {
      const groups = grid.querySelectorAll(isAudio ? '.audio-group' : '.video-group');
      groups.forEach(group => {
        const dropTarget = group.querySelector('.media-drop-target');
        const folderName = (dropTarget?.dataset.folderName || '').trim();
        if (folderName) {
          const count = group.querySelectorAll(isAudio ? '.audio-card' : '.video-card').length;
          folderMap.set(folderName.toLowerCase(), { displayName: folderName, count });
        }
      });
    }

    // Include empty folders from localStorage
    const emptyList = getEmptyFoldersStorage(activeMoveItem.type);
    emptyList.forEach(name => {
      if (name && !folderMap.has(name.toLowerCase())) {
        folderMap.set(name.toLowerCase(), { displayName: name, count: 0 });
      }
    });

    // Populate list container
    const listContainer = document.getElementById('moveFolderListContainer');
    if (listContainer) {
      listContainer.innerHTML = '';
      const folders = Array.from(folderMap.values()).sort((a, b) => a.displayName.localeCompare(b.displayName));

      if (folders.length === 0) {
        listContainer.innerHTML = `<p class="text-xs text-gray-500 italic p-2">Belum ada folder. Masukkan nama folder baru di bawah.</p>`;
      } else {
        folders.forEach(f => {
          const isCurrent = !activeMoveItem.isBatch && (currentFolder || '').toLowerCase() === f.displayName.toLowerCase();
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `w-full flex items-center justify-between p-2.5 rounded-xl border text-xs sm:text-sm transition-all ${
            isCurrent
              ? 'border-gray-700/50 bg-dark-700/30 text-gray-500 cursor-not-allowed'
              : 'border-gray-700/70 bg-dark-700/80 hover:bg-dark-600 text-gray-200 hover:text-white hover:border-gray-500'
          }`;
          btn.onclick = () => {
            if (isCurrent) return;
            selectMoveFolder(f.displayName, f.count);
          };
          btn.innerHTML = `
            <div class="flex items-center gap-2 min-w-0">
              <i class="ti ti-folder text-base ${isAudio ? 'text-green-400' : 'text-primary'} shrink-0"></i>
              <span class="font-medium truncate">${f.displayName}</span>
              ${isCurrent ? '<span class="text-[10px] text-gray-500 font-normal ml-1">(saat ini)</span>' : ''}
            </div>
            <span class="text-xs text-gray-400 shrink-0 ml-2">${f.count} item</span>
          `;
          btn.dataset.folderName = f.displayName;
          listContainer.appendChild(btn);
        });
      }
    }

    if (modal) {
      modal.classList.remove('hidden');
    }
  }

  function closeMoveMediaModal() {
    const modal = document.getElementById('moveMediaModal');
    if (modal) modal.classList.add('hidden');
    activeMoveItem = null;
    selectedMoveFolder = '';
  }

  function selectMoveFolder(folderName, existingCount = 0) {
    selectedMoveFolder = folderName;
    const customInput = document.getElementById('customMoveFolderName');
    if (customInput) customInput.value = '';

    const container = document.getElementById('moveFolderListContainer');
    if (container) {
      container.querySelectorAll('button').forEach(btn => {
        if (btn.dataset.folderName === folderName) {
          btn.className = `w-full flex items-center justify-between p-2.5 rounded-xl border text-xs sm:text-sm transition-all border-primary bg-primary/10 text-white font-medium shadow-sm`;
        } else {
          const isCurrent = !activeMoveItem?.isBatch && (activeMoveItem?.currentFolder || '').toLowerCase() === (btn.dataset.folderName || '').toLowerCase();
          btn.className = `w-full flex items-center justify-between p-2.5 rounded-xl border text-xs sm:text-sm transition-all ${
            isCurrent
              ? 'border-gray-700/50 bg-dark-700/30 text-gray-500 cursor-not-allowed'
              : 'border-gray-700/70 bg-dark-700/80 hover:bg-dark-600 text-gray-200 hover:text-white hover:border-gray-500'
          }`;
        }
      });
    }

    updateMovePreview(folderName, existingCount);
  }

  function handleCustomFolderInput() {
    const customInput = document.getElementById('customMoveFolderName');
    const folderName = (customInput?.value || '').trim();
    selectedMoveFolder = folderName;

    const container = document.getElementById('moveFolderListContainer');
    if (container) {
      container.querySelectorAll('button').forEach(btn => {
        const isCurrent = !activeMoveItem?.isBatch && (activeMoveItem?.currentFolder || '').toLowerCase() === (btn.dataset.folderName || '').toLowerCase();
        btn.className = `w-full flex items-center justify-between p-2.5 rounded-xl border text-xs sm:text-sm transition-all ${
          isCurrent
            ? 'border-gray-700/50 bg-dark-700/30 text-gray-500 cursor-not-allowed'
            : 'border-gray-700/70 bg-dark-700/80 hover:bg-dark-600 text-gray-200 hover:text-white hover:border-gray-500'
        }`;
      });
    }

    if (folderName) {
      updateMovePreview(folderName, 0);
    } else {
      const previewEl = document.getElementById('moveRenamePreview');
      if (previewEl) previewEl.textContent = 'Pilih folder tujuan di atas';
    }
  }

  function updateMovePreview(folderName, existingCount) {
    const previewEl = document.getElementById('moveRenamePreview');
    if (!previewEl || !folderName) return;

    const isAudio = activeMoveItem?.type === 'audio';
    const grid = document.getElementById(isAudio ? 'audioGrid' : 'videoGrid');
    let count = existingCount || 0;

    if (grid) {
      const group = Array.from(grid.querySelectorAll(isAudio ? '.audio-group' : '.video-group')).find(g => {
        const t = g.querySelector('.media-drop-target');
        return (t?.dataset.folderName || '').toLowerCase() === folderName.toLowerCase();
      });
      if (group) {
        count = group.querySelectorAll(isAudio ? '.audio-card' : '.video-card').length;
      }
    }

    const nextIndex = count + 1;
    if (activeMoveItem?.isBatch && activeMoveItem?.ids?.length > 1) {
      const totalCount = activeMoveItem.ids.length;
      const lastIndex = nextIndex + totalCount - 1;
      previewEl.innerHTML = `Nama baru otomatis: <strong class="text-white">${folderName} ${nextIndex}</strong> s/d <strong class="text-white">${folderName} ${lastIndex}</strong> (${totalCount} file)`;
    } else {
      previewEl.innerHTML = `Nama baru otomatis: <strong class="text-white">${folderName} ${nextIndex}</strong>`;
    }
  }

  async function confirmMoveMedia() {
    if (!activeMoveItem) return;

    const customInput = document.getElementById('customMoveFolderName');
    const customName = (customInput?.value || '').trim();
    const finalFolder = (customName || selectedMoveFolder || '').replace(/[\r\n\t]+/g, ' ').replace(/\s+/g, ' ').trim();

    if (!finalFolder) {
      showToast('error', 'Silakan pilih folder tujuan atau masukkan nama folder baru');
      return;
    }

    if (finalFolder.length > 120) {
      showToast('error', 'Nama folder maksimal 120 karakter');
      return;
    }

    if (!activeMoveItem.isBatch && (activeMoveItem.currentFolder || '').toLowerCase() === finalFolder.toLowerCase()) {
      showToast('error', 'Media sudah berada di folder tersebut');
      return;
    }

    const isAudio = activeMoveItem.type === 'audio';
    const isBatch = activeMoveItem.isBatch || (activeMoveItem.ids && activeMoveItem.ids.length > 1);

    let endpoint;
    let payload;

    if (isBatch) {
      endpoint = isAudio ? '/api/audios/batch-move' : '/api/videos/batch-move';
      payload = {
        folderName: finalFolder,
        ids: activeMoveItem.ids
      };
    } else {
      endpoint = isAudio
        ? `/api/audios/${activeMoveItem.id}/move`
        : `/api/videos/${activeMoveItem.id}/move`;
      payload = { folderName: finalFolder };
    }

    const confirmBtn = document.getElementById('confirmMoveBtn');
    if (confirmBtn) {
      confirmBtn.disabled = true;
      confirmBtn.innerHTML = `<i class="ti ti-loader animate-spin"></i><span>Memindahkan...</span>`;
    }

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: JSON.stringify(payload)
      });

      const data = await response.json();
      if (data.success) {
        removeEmptyFolderStorage(activeMoveItem.type, finalFolder);
        showToast('success', data.message || `File dipindahkan ke folder ${finalFolder}`);
        closeMoveMediaModal();
        clearAllSelections();
        setTimeout(() => location.reload(), 600);
      } else {
        showToast('error', data.error || 'Gagal memindahkan file');
        if (confirmBtn) {
          confirmBtn.disabled = false;
          confirmBtn.innerHTML = `<i class="ti ti-folder-check"></i><span>${isBatch ? `Pindahkan ${activeMoveItem.ids.length} File` : 'Pindahkan File'}</span>`;
        }
      }
    } catch (err) {
      showToast('error', 'Terjadi kesalahan saat memindahkan file');
      if (confirmBtn) {
        confirmBtn.disabled = false;
        confirmBtn.innerHTML = `<i class="ti ti-folder-check"></i><span>${isBatch ? `Pindahkan ${activeMoveItem.ids.length} File` : 'Pindahkan File'}</span>`;
      }
    }
  }

  async function renameMediaFolder(event, type) {
    event.preventDefault();
    event.stopPropagation();

    const group = event.currentTarget.closest(type === 'audio' ? '.audio-group' : '.video-group');
    const dropTarget = group?.querySelector('.media-drop-target');
    if (!group || !dropTarget) {
      showToast('error', 'Folder tidak ditemukan');
      return;
    }

    const currentName = dropTarget.dataset.folderName || '';
    const newName = prompt('Masukkan nama folder baru:', currentName);
    if (!newName) return;

    const folderName = newName.replace(/[\r\n\t]+/g, ' ').replace(/\s+/g, ' ').trim();
    if (!folderName) {
      showToast('error', 'Nama folder tidak boleh kosong');
      return;
    }
    if (folderName.length > 120) {
      showToast('error', 'Nama folder maksimal 120 karakter');
      return;
    }
    if (folderName.toLowerCase() === currentName.toLowerCase()) {
      showToast('error', 'Nama folder belum berubah');
      return;
    }

    let ids = [];
    try {
      ids = JSON.parse(group.dataset[type === 'audio' ? 'audioIds' : 'videoIds'] || '[]');
    } catch {
      ids = [];
    }
    if (!Array.isArray(ids) || ids.length === 0) {
      updateEmptyFolderStorage(type, currentName, folderName);
      dropTarget.dataset.folderName = folderName;
      group.dataset.name = folderName.toLowerCase();
      const titleEl = dropTarget.querySelector('h3');
      if (titleEl) titleEl.textContent = folderName;
      showToast('success', 'Folder berhasil di-rename');
      return;
    }

    const endpoint = type === 'audio' ? '/api/audios/rename-folder' : '/api/videos/rename-folder';
    const body = type === 'audio' ? { audioIds: ids, folderName } : { videoIds: ids, folderName };

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: JSON.stringify(body)
      });
      const data = await response.json();
      if (data.success) {
        showToast('success', data.message || 'Folder berhasil di-rename');
        setTimeout(() => location.reload(), 700);
      } else {
        showToast('error', data.error || 'Gagal rename folder');
      }
    } catch (error) {
      showToast('error', 'Gagal rename folder');
    }
  }

  // Delete single folder (for both populated and empty folders)
  async function deleteSingleFolder(event, type) {
    event.preventDefault();
    event.stopPropagation();

    const group = event.currentTarget.closest(type === 'audio' ? '.audio-group' : '.video-group');
    const dropTarget = group?.querySelector('.media-drop-target');
    if (!group || !dropTarget) {
      showToast('error', 'Folder tidak ditemukan');
      return;
    }

    const folderName = dropTarget.dataset.folderName || 'Folder';
    let ids = [];
    try {
      ids = JSON.parse(group.dataset[type === 'audio' ? 'audioIds' : 'videoIds'] || '[]');
    } catch {
      ids = [];
    }

    // If empty folder
    if (ids.length === 0) {
      if (!confirm(`Hapus folder kosong "${folderName}"?`)) return;
      removeEmptyFolderStorage(type, folderName);
      group.remove();
      showToast('success', `Folder "${folderName}" dihapus`);
      return;
    }

    const itemLabel = type === 'audio' ? 'audio' : 'video';
    if (!confirm(`Hapus folder "${folderName}" beserta ${ids.length} ${itemLabel} di dalamnya?`)) {
      return;
    }

    const endpoint = type === 'audio' ? '/api/audios/delete-folder' : '/api/videos/delete-folder';
    const body = type === 'audio' ? { audioIds: ids } : { videoIds: ids };

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: JSON.stringify(body)
      });
      const data = await response.json();
      if (data.success) {
        removeEmptyFolderStorage(type, folderName);
        showToast('success', data.message || 'Folder berhasil dihapus');
        setTimeout(() => location.reload(), 700);
      } else {
        showToast('error', data.error || 'Gagal menghapus folder');
      }
    } catch (error) {
      showToast('error', 'Gagal menghapus folder');
    }
  }

  // Folder storage helpers for contextual Video/Audio separation
  function getEmptyFoldersStorage(type) {
    const key = type === 'audio' ? 'emptyAudioFolders' : 'emptyVideoFolders';
    try {
      const data = JSON.parse(localStorage.getItem(key) || '[]');
      return Array.isArray(data) ? data : [];
    } catch {
      return [];
    }
  }

  function addEmptyFolderStorage(type, folderName) {
    const key = type === 'audio' ? 'emptyAudioFolders' : 'emptyVideoFolders';
    const list = getEmptyFoldersStorage(type);
    if (!list.some(name => name.toLowerCase() === folderName.toLowerCase())) {
      list.push(folderName);
      localStorage.setItem(key, JSON.stringify(list));
    }
  }

  function removeEmptyFolderStorage(type, folderName) {
    const key = type === 'audio' ? 'emptyAudioFolders' : 'emptyVideoFolders';
    let list = getEmptyFoldersStorage(type);
    list = list.filter(name => name.toLowerCase() !== (folderName || '').toLowerCase());
    localStorage.setItem(key, JSON.stringify(list));
  }

  function updateEmptyFolderStorage(type, oldName, newName) {
    const key = type === 'audio' ? 'emptyAudioFolders' : 'emptyVideoFolders';
    const list = getEmptyFoldersStorage(type).map(name => {
      return name.toLowerCase() === oldName.toLowerCase() ? newName : name;
    });
    localStorage.setItem(key, JSON.stringify(list));
  }

  function renderEmptyFolderDOM(type, folderName) {
    const isAudio = type === 'audio';
    const grid = document.getElementById(isAudio ? 'audioGrid' : 'videoGrid');
    if (!grid) return;

    // Check if folder already rendered
    const exists = Array.from(grid.querySelectorAll('.media-drop-target')).some(
      t => (t.dataset.folderName || '').toLowerCase() === folderName.toLowerCase()
    );
    if (exists) return;

    const groupDiv = document.createElement('div');
    groupDiv.className = `${isAudio ? 'audio-group' : 'video-group'} empty-media-folder`;
    groupDiv.dataset.name = folderName.toLowerCase();
    groupDiv.dataset[isAudio ? 'audioIds' : 'videoIds'] = '[]';

    const accentBorder = isAudio ? 'border-dashed border-green-500/50 hover:border-green-400' : 'border-dashed border-primary/50 hover:border-primary';
    const iconColor = isAudio ? 'text-green-400 bg-green-500/10' : 'text-primary bg-primary/10';
    const subtextColor = isAudio ? 'text-green-400/80' : 'text-primary/80';
    const renameHover = isAudio ? 'hover:text-green-400 hover:bg-green-500/10' : 'hover:text-primary hover:bg-primary/10';

    groupDiv.innerHTML = `
      <div class="media-drop-target bg-gray-800/50 rounded-lg p-3 flex items-center justify-between cursor-pointer hover:bg-gray-800/70 transition-colors border ${accentBorder}"
        data-media-type="${type}" data-folder-name="${folderName}">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg ${iconColor} flex items-center justify-center shrink-0">
            <i class="ti ti-folder-plus text-base sm:text-lg"></i>
          </div>
          <div>
            <h3 class="font-medium text-white text-sm sm:text-base">${folderName}</h3>
            <p class="text-xs ${subtextColor}">Folder kosong - siap menerima file</p>
          </div>
        </div>
        <div class="flex items-center gap-1.5 sm:gap-2">
          <button type="button" onclick="renameMediaFolder(event, '${type}')" title="Rename Folder"
            class="p-1.5 text-gray-400 ${renameHover} rounded-lg transition-colors">
            <i class="ti ti-pencil text-sm sm:text-base"></i>
          </button>
          <button type="button" onclick="deleteSingleFolder(event, '${type}')" title="Hapus Folder"
            class="p-1.5 text-gray-400 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-colors">
            <i class="ti ti-trash text-sm sm:text-base"></i>
          </button>
        </div>
      </div>
      <div class="${isAudio ? 'audio-group-content' : 'video-group-content'} mt-2"></div>
    `;

    const firstGroup = grid.querySelector(isAudio ? '.audio-group' : '.video-group');
    if (firstGroup) {
      grid.insertBefore(groupDiv, firstGroup);
