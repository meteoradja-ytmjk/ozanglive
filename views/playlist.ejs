<% layout('layout') -%>

<%
  let totalVideos = 0;
  let totalAudios = 0;
  if (playlists && playlists.length > 0) {
    playlists.forEach(function(p) {
      totalVideos += Number(p.video_count || 0);
      totalAudios += Number(p.audio_count || 0);
    });
  }
%>

<!-- Page Header -->
<div class="mb-4">
  <h2 class="text-2xl font-bold flex items-center gap-2.5 text-white">
    <span>Playlists</span>
    <span class="text-xs px-2.5 py-0.5 rounded-full bg-primary/20 text-primary border border-primary/30 font-semibold">
      <%= playlists ? playlists.length : 0 %>
    </span>
  </h2>
  <p class="text-gray-400 text-xs sm:text-sm mt-0.5">Kelola susunan video dan audio untuk otomasi live streaming</p>
</div>

<!-- Single Line Toolbar: Cari playlist (lebih panjang), Terbaru Diupdate & Create Playlist (ukurannya sama) -->
<div class="flex items-center gap-2.5 sm:gap-3 mb-4 w-full">
  <!-- 1. Cari Playlist (Lebih panjang / flex-1) -->
  <div class="relative flex-1 min-w-0">
    <input type="text" id="searchPlaylists" placeholder="Cari playlist berdasarkan nama atau deskripsi..."
      class="w-full h-10 bg-dark-700 border border-gray-600 text-white pl-9 pr-3 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary text-xs sm:text-sm placeholder-gray-400 transition-all">
    <i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
  </div>

  <!-- 2. Terbaru Diupdate (Sort Dropdown) -->
  <div class="w-40 sm:w-44 flex-shrink-0">
    <select id="sortPlaylists"
      class="w-full h-10 bg-dark-700 border border-gray-600 text-white px-3 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary text-xs sm:text-sm cursor-pointer transition-all">
      <option value="newest">Terbaru Diupdate</option>
      <option value="oldest">Terlama Dibuat</option>
      <option value="name">Nama (A-Z)</option>
    </select>
  </div>

  <!-- 3. Create Playlist (Ukuran sama persis dengan Terbaru Diupdate) -->
  <button onclick="openCreatePlaylistModal()"
    class="w-40 sm:w-44 h-10 flex-shrink-0 rounded-lg text-xs sm:text-sm font-semibold text-white bg-gradient-to-r from-primary to-purple-600 hover:from-primary/90 hover:to-purple-500 shadow-md shadow-primary/25 active:scale-[0.98] transition-all flex items-center justify-center gap-1.5">
    <i class="ti ti-plus text-base"></i>
    <span>Create Playlist</span>
  </button>
</div>

<!-- Playlists Container (Single-Line Compact List) -->
<div id="playlistsContainer" class="flex flex-col gap-2">
  <% if (playlists && playlists.length > 0) { %>
    <% playlists.forEach(function(playlist) { %>
      <div class="playlist-card group bg-dark-800/90 hover:bg-dark-750 backdrop-blur-md rounded-xl border border-gray-700/60 hover:border-primary/50 shadow-sm px-3.5 py-2.5 flex items-center justify-between gap-3 transition-all duration-200" 
           data-playlist-id="<%= playlist.id %>" 
           data-created-at="<%= playlist.created_at %>" 
           data-updated-at="<%= playlist.updated_at %>">
        
        <!-- Left: Icon + Title & Description -->
        <div class="flex items-center gap-3 min-w-0 flex-1">
          <div class="w-8 h-8 rounded-lg bg-primary/15 border border-primary/25 text-primary flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <i class="ti ti-playlist text-base"></i>
          </div>
          
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <h3 class="font-bold text-sm text-white hover:text-primary transition-colors truncate cursor-pointer tracking-tight" 
                  onclick="viewPlaylist('<%= playlist.id %>')" 
                  title="<%= playlist.name %>">
                <%= playlist.name %>
              </h3>
              <!-- Mode Badge -->
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-dark-900/80 border border-gray-700/60 text-[10px] font-semibold flex-shrink-0">
                <i class="ti ti-<%= (playlist.shuffle || playlist.is_shuffle) ? 'arrows-shuffle text-amber-400' : 'list-numbers text-cyan-400' %> text-xs"></i>
                <span class="<%= (playlist.shuffle || playlist.is_shuffle) ? 'text-amber-300' : 'text-cyan-300' %>">
                  <%= (playlist.shuffle || playlist.is_shuffle) ? 'Shuffle' : 'Sequential' %>
                </span>
              </span>
            </div>
            <p class="text-gray-400 text-xs truncate mt-0.5 max-w-xl">
              <%= playlist.description || 'Tidak ada deskripsi' %>
            </p>
          </div>
        </div>

        <!-- Middle: Media Count Chips (Hidden on small mobile) -->
        <div class="hidden sm:flex items-center gap-2 text-xs font-medium text-gray-300 px-2.5 py-1 rounded-lg bg-dark-900/50 border border-gray-700/50 flex-shrink-0">
          <span class="flex items-center gap-1 text-gray-300"><i class="ti ti-video text-primary text-xs"></i><%= playlist.video_count || 0 %></span>
          <span class="text-gray-600">•</span>
          <span class="flex items-center gap-1 text-gray-300"><i class="ti ti-music text-emerald-400 text-xs"></i><%= playlist.audio_count || 0 %></span>
        </div>
        
        <!-- Right: Action Buttons Dock (Single Line) -->
        <div class="flex items-center gap-1.5 flex-shrink-0">
          <button onclick="viewPlaylist('<%= playlist.id %>')" 
            class="h-8 px-2.5 sm:px-3 rounded-lg bg-primary/15 hover:bg-primary/25 border border-primary/30 text-primary hover:text-white text-xs font-semibold flex items-center gap-1 active:scale-95 transition-all shadow-sm"
            title="Open playlist details">
            <i class="ti ti-eye text-sm"></i>
            <span class="hidden md:inline">Open</span>
          </button>
          
          <button class="w-8 h-8 flex items-center justify-center rounded-lg bg-dark-750/90 hover:bg-emerald-500/20 text-gray-400 hover:text-emerald-400 border border-gray-700/60 hover:border-emerald-500/30 active:scale-95 transition-all" 
            onclick="editPlaylist('<%= playlist.id %>')" 
            title="Edit Playlist">
            <i class="ti ti-pencil text-sm"></i>
          </button>
          
          <button class="w-8 h-8 flex items-center justify-center rounded-lg bg-dark-750/90 hover:bg-red-500/20 text-gray-400 hover:text-red-400 border border-gray-700/60 hover:border-red-500/30 active:scale-95 transition-all" 
            onclick="deletePlaylist('<%= playlist.id %>', '<%= playlist.name.replace(/'/g, "\\'") %>')" 
            title="Delete Playlist">
            <i class="ti ti-trash text-sm"></i>
          </button>
        </div>

      </div>
    <% }); %>
  <% } else { %>
    <div class="col-span-full text-center py-12 bg-dark-800/90 rounded-xl border border-gray-700/60 shadow-md p-8">
      <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-primary/20 to-purple-600/20 border border-primary/30 flex items-center justify-center text-primary shadow-md shadow-primary/20 mx-auto mb-3">
        <i class="ti ti-playlist text-2xl"></i>
      </div>
      <h3 class="text-base font-bold text-white mb-1">Belum ada playlist</h3>
      <p class="text-gray-400 text-xs mb-4 max-w-sm mx-auto">Buat playlist pertama kamu untuk mulai menyusun antrean video & audio streaming</p>
      <button onclick="openCreatePlaylistModal()" 
        class="h-9 px-4 rounded-xl text-xs font-semibold text-white bg-gradient-to-r from-primary to-purple-600 hover:from-primary/90 hover:to-purple-500 shadow-md shadow-primary/25 active:scale-[0.98] transition-all inline-flex items-center gap-1.5">
        <i class="ti ti-plus text-sm"></i>
        <span>Create Playlist</span>
      </button>
    </div>
  <% } %>
</div>

<!-- Pagination Controls -->
<div class="mt-6 flex items-center justify-between">
  <p class="text-xs sm:text-sm text-gray-400" id="paginationInfo">Showing 1-<%= Math.min(8, playlists ? playlists.length : 0) %> of <%= playlists ? playlists.length : 0 %> playlists</p>
  <div class="flex items-center gap-2" id="paginationControls">
    <button type="button" class="w-9 h-9 flex items-center justify-center rounded-xl bg-dark-800/90 border border-gray-700/60 text-gray-400 hover:text-white hover:border-primary/40 shadow-sm transition-all" id="prevPage" onclick="changePage(-1)">
      <i class="ti ti-chevron-left"></i>
    </button>
    <div id="pageNumbers" class="flex items-center gap-1.5"></div>
    <button type="button" class="w-9 h-9 flex items-center justify-center rounded-xl bg-dark-800/90 border border-gray-700/60 text-gray-400 hover:text-white hover:border-primary/40 shadow-sm transition-all" id="nextPage" onclick="changePage(1)">
      <i class="ti ti-chevron-right"></i>
    </button>
  </div>
</div>

<!-- Create/Edit Playlist Modal -->
<div id="playlistModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center z-50">
  <div class="bg-dark-800/95 backdrop-blur-xl border border-gray-700/80 rounded-2xl shadow-2xl p-6 w-full max-w-4xl mx-4 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-700/60">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
          <i class="ti ti-list-details text-lg"></i>
        </div>
        <h3 id="modalTitle" class="text-lg sm:text-xl font-bold text-white">Create New Playlist</h3>
      </div>
      <button onclick="closePlaylistModal()" class="w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 hover:text-white hover:bg-gray-700/50 transition-colors">
        <i class="ti ti-x text-lg"></i>
      </button>
    </div>
    
    <form id="playlistForm" class="space-y-6">
      <input type="hidden" id="playlistId" name="playlistId">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="playlistName" class="block text-xs sm:text-sm font-medium text-white mb-2">Playlist Name <span class="text-red-400">*</span></label>
          <input type="text" id="playlistName" name="name" required placeholder="Enter playlist name..."
            class="w-full bg-dark-750/90 text-white px-3.5 py-2.5 border border-gray-700/70 rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-xs sm:text-sm transition-all">
        </div>
        
        <div>
            <div class="flex items-center mb-2">
              <label for="playlistShuffle" class="text-xs sm:text-sm font-medium text-white">Playback Mode</label>
              <div class="relative ml-2 group">
                <i class="ti ti-help-circle text-gray-400 hover:text-primary cursor-help"></i>
                <div class="absolute left-full top-1/2 -translate-y-1/2 ml-2 hidden group-hover:block w-64 p-3 bg-dark-700 text-xs text-gray-200 rounded-xl shadow-xl border border-gray-600/50 z-10">
                  <div class="space-y-2">
                    <div><strong class="text-white">Sequential:</strong> Video berurutan sesuai urutan dalam playlist</div>
                    <div><strong class="text-white">Shuffle:</strong> Video diacak secara random</div>
                  </div>
                </div>
              </div>
            </div>
          <select id="playlistShuffle" name="shuffle"
            class="w-full bg-dark-750/90 border border-gray-700/70 text-white px-3.5 py-2.5 rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-xs sm:text-sm transition-all cursor-pointer">
            <option value="false">Sequential</option>
            <option value="true">Shuffle</option>
          </select>
        </div>
      </div>
      
      <div>
        <label class="block text-xs sm:text-sm font-medium text-white mb-3">Select Media</label>
        <!-- Single panel: Select Media with checkboxes, shuffle & pin -->
        <div>
          <!-- Tab Buttons -->
          <div class="flex w-full mb-3 border border-gray-700/60 rounded-xl overflow-hidden bg-dark-750/70 p-1 gap-1">
            <button type="button" id="availableVideosTab" onclick="switchAvailableTab('videos')" 
              class="flex-1 py-2 text-xs sm:text-sm font-medium text-center rounded-lg transition-all text-white bg-primary shadow-sm">
              <i class="ti ti-video mr-1"></i>Videos
            </button>
            <button type="button" id="availableAudiosTab" onclick="switchAvailableTab('audios')" 
              class="flex-1 py-2 text-xs sm:text-sm font-medium text-center rounded-lg transition-all text-gray-400 hover:text-white hover:bg-gray-700/50">
              <i class="ti ti-music mr-1"></i>Audios
            </button>
          </div>

          <!-- Selected count -->
          <div class="flex items-center justify-end mb-2 px-1">
            <span class="text-xs text-gray-400" id="selectedMediaCount">0 selected</span>
          </div>
          
          <!-- Videos Panel -->
          <div id="availableVideosPanel" class="bg-dark-750/90 rounded-2xl border border-gray-700/60 shadow-lg">
            <div class="p-2.5 border-b border-gray-700/60 space-y-2">
              <div class="relative">
                <input type="text" id="searchVideos" placeholder="Search videos..."
                  class="w-full bg-dark-800 text-white pl-8 pr-4 py-2 rounded-xl text-xs sm:text-sm focus:outline-none focus:border-primary border border-gray-700">
                <i class="ti ti-search absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs sm:text-sm"></i>
              </div>
              <button type="button" onclick="shuffleSelectedVideos()" class="w-full h-8 flex items-center justify-center gap-2 rounded-xl bg-primary/10 border border-primary/30 hover:bg-primary/20 text-primary text-xs font-medium transition-all active:scale-[0.99]">
                <span>&#x1F500;</span> Shuffle Video Order
              </button>
            </div>
            <div id="availableVideos" class="p-2 space-y-1 min-h-[220px] max-h-72 overflow-y-auto custom-scrollbar">
              <!-- Rendered dynamically by JS with folder grouping + checkboxes -->
            </div>
          </div>
          
          <!-- Audios Panel -->
          <div id="availableAudiosPanel" class="bg-dark-750/90 rounded-2xl border border-gray-700/60 shadow-lg hidden">
            <div class="p-2.5 border-b border-gray-700/60 space-y-2">
              <div class="relative">
                <input type="text" id="searchAudios" placeholder="Search audios..."
                  class="w-full bg-dark-800 text-white pl-8 pr-4 py-2 rounded-xl text-xs sm:text-sm focus:outline-none focus:border-primary border border-gray-700">
                <i class="ti ti-search absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs sm:text-sm"></i>
              </div>
              <button type="button" onclick="shuffleSelectedAudios()" class="w-full h-8 flex items-center justify-center gap-2 rounded-xl bg-emerald-500/10 border border-emerald-500/30 hover:bg-emerald-500/20 text-emerald-400 text-xs font-medium transition-all active:scale-[0.99]">
                <span>&#x1F500;</span> Shuffle Audio Order
              </button>
            </div>
            <div id="availableAudios" class="p-2 space-y-1 min-h-[220px] max-h-72 overflow-y-auto custom-scrollbar">
              <!-- Rendered dynamically by JS with folder grouping + checkboxes -->
            </div>
          </div>
        </div>
      </div>
      
      <div class="flex justify-end gap-3 pt-4 border-t border-gray-700/60">
        <button type="button" onclick="closePlaylistModal()" 
          class="px-4 py-2 text-xs sm:text-sm text-gray-400 hover:text-white rounded-xl hover:bg-gray-700/50 transition-colors">
          Cancel
        </button>
        <button type="submit" 
          class="h-10 px-6 rounded-xl text-xs sm:text-sm font-semibold text-white bg-gradient-to-r from-primary to-purple-600 hover:from-primary/90 hover:to-purple-500 shadow-md shadow-primary/25 active:scale-[0.98] transition-all">
          <span id="submitButtonText">Create Playlist</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- View Playlist Modal -->
<div id="viewPlaylistModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center z-50">
  <div class="bg-dark-800/95 backdrop-blur-xl border border-gray-700/80 rounded-2xl shadow-2xl p-6 w-full max-w-4xl mx-4 max-h-[90vh] overflow-y-auto">
    <div class="flex items-start justify-between mb-6 pb-4 border-b border-gray-700/60">
      <div>
        <h3 id="viewPlaylistTitle" class="text-lg sm:text-xl font-bold text-white">Playlist Details</h3>
        <p id="viewPlaylistDescription" class="text-gray-400 text-xs sm:text-sm mt-1"></p>
      </div>
      <button onclick="closeViewPlaylistModal()" class="w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 hover:text-white hover:bg-gray-700/50 transition-colors">
        <i class="ti ti-x text-lg"></i>
      </button>
    </div>
    
    <div class="mb-4 flex items-center justify-between">
      <div class="flex items-center gap-3 text-xs sm:text-sm text-gray-400">
        <span id="viewVideoCount" class="px-2.5 py-1 rounded-lg bg-dark-700/80 border border-gray-700/60 text-white font-medium">0 videos</span>
        <span id="viewPlaybackMode" class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-dark-700/80 border border-gray-700/60 text-white font-medium">
          <i class="ti ti-list-numbers text-primary"></i>
          Sequential
        </span>
      </div>
      <div class="flex gap-2">
        <button id="editPlaylistBtn" class="h-9 px-4 rounded-xl text-xs sm:text-sm font-semibold text-white bg-primary hover:bg-secondary shadow-sm active:scale-95 transition-all flex items-center gap-1.5">
          <i class="ti ti-pencil text-sm"></i>
          <span>Edit</span>
        </button>
      </div>
    </div>

    <!-- Shared preview player (single instance to keep CPU/memory low) -->
    <div id="previewPlayerWrapper" class="hidden mb-4 bg-dark-900 rounded-2xl border border-gray-700/70 overflow-hidden shadow-xl">
      <div class="flex items-center justify-between px-3.5 py-2.5 border-b border-gray-700/60 bg-dark-750">
        <div class="flex items-center gap-2 min-w-0">
          <i id="previewPlayerIcon" class="ti ti-player-play text-primary flex-shrink-0"></i>
          <span id="previewPlayerTitle" class="text-xs sm:text-sm font-medium text-white truncate"></span>
        </div>
        <button type="button" onclick="closePreviewPlayer()" class="text-gray-400 hover:text-white flex-shrink-0" title="Close preview">
          <i class="ti ti-x"></i>
        </button>
      </div>
      <div id="previewPlayerSlot" class="bg-black"></div>
    </div>
    
    <div id="playlistVideos" class="space-y-2">
      <!-- Videos will be loaded here -->
    </div>
  </div>
</div>

<script>
let selectedVideos = [];
let selectedAudios = [];
let currentPlaylistId = null;
let allVideos = <%- JSON.stringify(videos || []) %>;
let allAudios = <%- JSON.stringify(audios || []) %>;

// Tab switching functions
function switchAvailableTab(tab) {
  const videosTab = document.getElementById('availableVideosTab');
  const audiosTab = document.getElementById('availableAudiosTab');
  const videosPanel = document.getElementById('availableVideosPanel');
  const audiosPanel = document.getElementById('availableAudiosPanel');
  
  if (tab === 'videos') {
    videosTab.classList.add('border-primary', 'text-primary', 'bg-primary/20');
    videosTab.classList.remove('border-transparent', 'text-gray-400', 'hover:bg-gray-700/50');
    audiosTab.classList.remove('border-primary', 'text-primary', 'bg-primary/20');
    audiosTab.classList.add('border-transparent', 'text-gray-400', 'hover:bg-gray-700/50');
    videosPanel.classList.remove('hidden');
    audiosPanel.classList.add('hidden');
  } else {
    audiosTab.classList.add('border-primary', 'text-primary', 'bg-primary/20');
    audiosTab.classList.remove('border-transparent', 'text-gray-400', 'hover:bg-gray-700/50');
    videosTab.classList.remove('border-primary', 'text-primary', 'bg-primary/20');
    videosTab.classList.add('border-transparent', 'text-gray-400', 'hover:bg-gray-700/50');
    audiosPanel.classList.remove('hidden');
    videosPanel.classList.add('hidden');
  }
}

function switchSelectedTab(tab) {
  // No longer needed - single combined panel
}

function openCreatePlaylistModal() {
  currentPlaylistId = null;
  selectedVideos = [];
  selectedAudios = [];
  document.getElementById('modalTitle').textContent = 'Create New Playlist';
  document.getElementById('submitButtonText').textContent = 'Create Playlist';
  document.getElementById('playlistForm').reset();
  document.getElementById('playlistId').value = '';
  // Reset tabs to default (videos)
  switchAvailableTab('videos');
  updateAvailableVideosDisplay();
  updateAvailableAudiosDisplay();
  document.getElementById('playlistModal').classList.remove('hidden');
  document.getElementById('playlistModal').classList.add('flex');
}

function closePlaylistModal() {
  document.getElementById('playlistModal').classList.add('hidden');
  document.getElementById('playlistModal').classList.remove('flex');
}

function closeViewPlaylistModal() {
  closePreviewPlayer();
  document.getElementById('viewPlaylistModal').classList.add('hidden');
  document.getElementById('viewPlaylistModal').classList.remove('flex');
}

function addVideoToPlaylist(videoId) {
  const video = allVideos.find(v => v.id == videoId);
  if (video && !selectedVideos.find(v => v.id == videoId)) {
    selectedVideos.push(video);
    updateAvailableVideosDisplay();
  }
}

function removeVideoFromPlaylist(videoId) {
  selectedVideos = selectedVideos.filter(v => v.id != videoId);
  updateAvailableVideosDisplay();
}

// Toggle video via checkbox
function toggleVideoSelection(videoId) {
  if (selectedVideos.find(v => v.id == videoId)) {
    removeVideoFromPlaylist(videoId);
  } else {
    addVideoToPlaylist(videoId);
  }
}

// Toggle audio via checkbox
function toggleAudioSelection(audioId) {
  if (selectedAudios.find(a => a.id == audioId)) {
    removeAudioFromPlaylist(audioId);
  } else {
    addAudioToPlaylist(audioId);
  }
}

// Pin item to top (move to position 0)
function pinMediaItem(type, id) {
  if (type === 'video') {
    const idx = selectedVideos.findIndex(v => v.id == id);
    if (idx > 0) {
      const item = selectedVideos.splice(idx, 1)[0];
      selectedVideos.unshift(item);
    }
  } else {
    const idx = selectedAudios.findIndex(a => a.id == id);
    if (idx > 0) {
      const item = selectedAudios.splice(idx, 1)[0];
      selectedAudios.unshift(item);
    }
  }
  // Re-render current tab to reflect new order
  updateAvailableVideosDisplay();
  updateAvailableAudiosDisplay();
}

// Shuffle selected videos randomly and re-render immediately
function shuffleSelectedVideos() {
  if (selectedVideos.length < 2) return;
  for (let i = selectedVideos.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [selectedVideos[i], selectedVideos[j]] = [selectedVideos[j], selectedVideos[i]];
  }
  // Re-render to show new order with visual feedback
  updateAvailableVideosDisplay();
  // Flash effect on checked items to show order changed
  setTimeout(() => {
    document.querySelectorAll('#availableVideos input[type="checkbox"]:checked').forEach(cb => {
      const row = cb.closest('div');
      if (row) {
        row.classList.add('ring-1', 'ring-primary/50');
        setTimeout(() => row.classList.remove('ring-1', 'ring-primary/50'), 600);
      }
    });
  }, 50);
}

// Shuffle selected audios randomly and re-render immediately
function shuffleSelectedAudios() {
  if (selectedAudios.length < 2) return;
  for (let i = selectedAudios.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [selectedAudios[i], selectedAudios[j]] = [selectedAudios[j], selectedAudios[i]];
  }
  // Re-render to show new order with visual feedback
  updateAvailableAudiosDisplay();
  // Flash effect on checked items
  setTimeout(() => {
    document.querySelectorAll('#availableAudios input[type="checkbox"]:checked').forEach(cb => {
      const row = cb.closest('div');
      if (row) {
        row.classList.add('ring-1', 'ring-green-500/50');
